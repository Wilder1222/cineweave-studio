      "requires": ["CreativeBrief"],
      "produces": ["CharacterExplorationBrief", "CharacterOptionSet"],
      "humanGate": "none"
    },
    {
      "stepId": "prompt-candidates",
      "skill": "cineweave-prompt",
      "route": "prompt_compile",
      "invocationMode": "composed",
      "requires": ["CharacterExplorationBrief", "CharacterOptionSet"],
      "produces": ["ImagePrompt"],
      "dependsOn": ["character-explore"],
      "humanGate": "approve"
    },
    {
      "stepId": "production-candidate-board",
      "skill": "cineweave-production",
      "route": "asset_recipe",
      "invocationMode": "composed",
      "requires": ["CharacterExplorationBrief", "CharacterOptionSet", "ImagePrompt"],
      "produces": ["AssetRecipe", "ControlChannelSet"],
      "dependsOn": ["character-explore", "prompt-candidates"],
      "humanGate": "approve"
    },
    {
      "stepId": "character-converge",
      "skill": "cineweave-character",
      "route": "character_converge",
      "invocationMode": "composed",
      "requires": ["CharacterOptionSet", "CandidateObservationIds", "UserPreferenceInput"],
      "produces": ["CharacterPreferenceFeedback"],
      "dependsOn": ["production-candidate-board"],
      "humanGate": "select"
    }
  ],
  "outputs": [
    { "contractKind": "cineweave_codex_character_exploration_brief", "producer": "character-explore" },
    { "contractKind": "cineweave_codex_character_option_set", "producer": "character-explore" },
    { "contractKind": "cineweave_codex_asset_recipe", "producer": "production-candidate-board" },
    { "contractKind": "cineweave_codex_character_preference_feedback", "producer": "character-converge" }
