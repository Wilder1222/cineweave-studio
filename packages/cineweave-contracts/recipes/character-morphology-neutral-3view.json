      "acceptedKinds": ["cineweave_codex_character_spec"],
      "required": false,
      "cardinality": "zero_or_one",
      "description": "Optional converged CharacterSpec when morphology is being revalidated."
    },
    {
      "slotName": "controlSet",
      "role": "control",
      "acceptedKinds": ["cineweave_codex_control_channel_set"],
      "required": true,
      "cardinality": "one",
      "description": "Hard lock and fallback priorities."
    },
    {
      "slotName": "evidenceBundle",
      "role": "evidence",
      "acceptedKinds": ["cineweave_codex_evidence_bundle"],
      "required": true,
      "cardinality": "one",
      "description": "Role-scoped morphology and rights evidence."
    }
  ],
  "layout": {
    "type": "turnaround",
    "rows": 1,
    "cols": 3,
    "canvas": { "aspectRatio": "3:1", "sizeClass": "wide" },
    "tileAspectRatio": "3:4",
    "labelPolicy": "outside_tile",
    "cameraConsistency": true,
    "backgroundPolicy": "locked",
    "lightingPolicy": "locked"
  },
  "sharedInvariants": [
    "All morphology axes, relations and locks",
    "Neutral expression, grooming, wardrobe, camera family, working distance, background and light",
    "No beauty score and no automatic identity lock"
  ],
  "tasks": [
    {
      "taskId": "task.morphology.front",
      "label": "front",
      "outputSlot": "front",
      "delta": [{ "fieldPath": "camera.view", "operation": "select", "value": "front", "rationale": "Only the required neutral view changes." }],
      "controlChannelIds": ["control.identity.face", "control.body.rhythm", "control.appearance.lock", "control.camera.lock"],
      "evaluationCriteria": ["Hard axes preserved", "Structural relations readable", "Neutral fixture unchanged"],
      "promptIntent": "Neutral front morphology evidence; do not beautify or restyle."
    },
    {
      "taskId": "task.morphology.three-quarter",
      "label": "three-quarter-left",
      "outputSlot": "three_quarter_left",
      "delta": [{ "fieldPath": "camera.view", "operation": "select", "value": "three_quarter", "rationale": "Only the required neutral left three-quarter view changes." }],
      "controlChannelIds": ["control.identity.face", "control.body.rhythm", "control.appearance.lock", "control.camera.lock"],
      "evaluationCriteria": ["Hard axes preserved", "Cheek-jaw transitions coherent", "Neutral fixture unchanged"],
      "promptIntent": "Neutral left three-quarter morphology evidence; preserve exact relations."
    },
    {
      "taskId": "task.morphology.profile",
      "label": "profile-left",
      "outputSlot": "profile_left",
      "delta": [{ "fieldPath": "camera.view", "operation": "select", "value": "profile", "rationale": "Only the required neutral left profile view changes." }],
      "controlChannelIds": ["control.identity.face", "control.body.rhythm", "control.appearance.lock", "control.camera.lock"],
      "evaluationCriteria": ["Hard axes preserved", "Nose, lips, chin and head profile coherent", "Neutral fixture unchanged"],
      "promptIntent": "Neutral left profile morphology evidence; preserve exact relations."
    }
  ],
  "assembly": {
