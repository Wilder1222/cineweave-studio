  "outputType": "morphology_turnaround",
  "purpose": "在固定中性条件下验证语义形态轴、结构关系和锁定跨正面、四分之三与侧面保持一致。",
  "recipeMode": "template",
  "parameters": [
    {
      "name": "qualityBudget",
      "type": "enum",
      "description": "形态验证质量预算。",
      "required": true,
      "default": "explore",
      "values": ["draft", "explore", "final"]
    }
  ],
  "inputSlots": [
    {
      "slotName": "morphologySpec",
      "role": "morphology",
      "acceptedKinds": ["cineweave_codex_character_morphology_spec"],
      "required": true,
      "cardinality": "one",
      "description": "Provider-neutral semantic axes, relations, locks and neutral fixture."
    },
    {
      "slotName": "characterSpec",
