    "ordering": ["task.morphology.front", "task.morphology.three-quarter", "task.morphology.profile"],
    "preserveTaskResolution": true,
    "cropPolicy": "face_safe",
    "labelMode": "deterministic_text",
    "outputFormat": "png"
  },
  "retryPolicy": {
    "strategy": "failed_tasks_only",
    "maxRetries": 3,
    "preserveSuccessfulTasks": true,
    "stopOnHardFailure": true
  },
  "evaluation": {
    "criteria": ["View consistency", "Axis preservation", "Relation coherence", "Anatomical plausibility", "Lock preservation"],
