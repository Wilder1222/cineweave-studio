{
  "kind": "cineweave_codex_asset_recipe",
  "contractVersion": "2.0.0",
  "worldId": "world-template",
  "recipeId": "recipe.cross-representation-character-6up",
  "title": "同一角色跨视觉表现六宫格",
  "version": 1,
  "status": "active",
  "ownerSkill": "cineweave-production",
  "category": "mixed",
  "outputType": "cross_representation_sheet",
  "purpose": "在同一中性人物夹具下比较真人、Anime、Manga、Illustration、Stylized 3D 与 Hybrid 六种表现，验证语义身份锚在媒介转换后仍然成立。",
  "recipeMode": "template",
  "parameters": [
    {
      "name": "qualityBudget",
      "type": "enum",
      "description": "跨表现验证质量预算。",
      "required": true,
      "default": "final",
      "values": ["explore", "final"]
    }
  ],
  "inputSlots": [
    {
      "slotName": "characterSpec",
      "role": "identity",
      "acceptedKinds": ["cineweave_codex_character_spec"],
      "required": true,
      "cardinality": "one",
      "description": "One locked Canonical Character shared by every tile."
    },
    {
      "slotName": "morphologySpec",
      "role": "morphology",
      "acceptedKinds": ["cineweave_codex_character_morphology_spec"],
      "required": true,
      "cardinality": "one",
      "description": "Semantic axes, relations and hard identity locks shared by every tile."
    },
    {
      "slotName": "appearanceState",
      "role": "appearance",
      "acceptedKinds": ["cineweave_codex_character_appearance_state"],
      "required": true,
      "cardinality": "one",
      "description": "One exact appearance construction shared by every tile."
    },
    {
      "slotName": "representationBindings",
      "role": "representation",
      "acceptedKinds": ["cineweave_codex_representation_binding"],
      "required": true,
      "cardinality": "one_or_more",
      "description": "One approved binding per requested representation family; missing families block their tiles."
    },
    {
      "slotName": "styleCompiles",
      "role": "style",
      "acceptedKinds": ["cineweave_codex_style_compile"],
      "required": true,
      "cardinality": "one_or_more",
      "description": "One exact scale-aware compile per representation family."
    },
    {
      "slotName": "controlSet",
      "role": "control",
      "acceptedKinds": ["cineweave_codex_control_channel_set"],
      "required": true,
      "cardinality": "one",
      "description": "Hard Canon, fixture and family-binding controls."
    },
    {
      "slotName": "evidenceBundle",
      "role": "evidence",
      "acceptedKinds": ["cineweave_codex_evidence_bundle"],
      "required": true,
      "cardinality": "one",
      "description": "Identity, representation-family and rights evidence for all six tasks."
    }
  ],
  "layout": {
    "type": "contact_sheet",
    "rows": 2,
    "cols": 3,
    "canvas": { "aspectRatio": "3:2", "sizeClass": "wide" },
    "tileAspectRatio": "3:4",
    "labelPolicy": "outside_tile",
    "cameraConsistency": true,
    "backgroundPolicy": "locked",
    "lightingPolicy": "locked"
  },
  "sharedInvariants": [
    "Exact CharacterSpec, MorphologySpec and AppearanceState",
    "Neutral expression, camera, crop, background, scene facts and physical light-source state",
    "Each tile uses only its exact approved RepresentationBinding and StyleCompile",
    "No cross-family pixel-similarity requirement; compare semantic relations, silhouette, marks and behavior",
    "No family may mutate Canon or borrow identity from a style reference"
  ],
  "tasks": [
    {
      "taskId": "task.cross.photoreal",
      "label": "natural-human",
      "outputSlot": "photoreal",
      "delta": [{ "fieldPath": "representation.family", "operation": "select", "value": "photoreal", "rationale": "Select only the approved photoreal binding and compile." }],
      "controlChannelIds": ["control.identity.face", "control.body.rhythm", "control.appearance.lock", "control.fixture.lock", "control.representation.binding"],
      "evaluationCriteria": ["Canonical relations", "Natural asymmetry", "Identity marks", "Body rhythm", "Fixture unchanged"],
      "promptIntent": "Neutral natural-human translation of the exact Canon."
    },
    {
      "taskId": "task.cross.anime",
      "label": "anime",
      "outputSlot": "anime",
      "delta": [{ "fieldPath": "representation.family", "operation": "select", "value": "anime", "rationale": "Select only the approved Anime binding and compile." }],
      "controlChannelIds": ["control.identity.face", "control.body.rhythm", "control.appearance.lock", "control.fixture.lock", "control.representation.binding"],
      "evaluationCriteria": ["Eye-shape relation", "Face silhouette", "Hair grouping", "Body rhythm", "Fixture unchanged"],
      "promptIntent": "Neutral Anime translation of the exact Canon."
    },
    {
      "taskId": "task.cross.manga",
      "label": "manga",
      "outputSlot": "manga",
      "delta": [{ "fieldPath": "representation.family", "operation": "select", "value": "manga", "rationale": "Select only the approved Manga binding and compile." }],
      "controlChannelIds": ["control.identity.face", "control.body.rhythm", "control.appearance.lock", "control.fixture.lock", "control.representation.binding"],
      "evaluationCriteria": ["Semantic facial relations", "Ink silhouette", "Identity marks", "Costume cues", "Fixture unchanged"],
      "promptIntent": "Neutral Manga translation of the exact Canon."
    },
    {
      "taskId": "task.cross.illustration",
      "label": "illustration",
      "outputSlot": "illustration",
      "delta": [{ "fieldPath": "representation.family", "operation": "select", "value": "illustration", "rationale": "Select only the approved Illustration binding and compile." }],
      "controlChannelIds": ["control.identity.face", "control.body.rhythm", "control.appearance.lock", "control.fixture.lock", "control.representation.binding"],
      "evaluationCriteria": ["Face and body rhythm", "Signature marks", "Edge-language mapping", "Costume identity", "Fixture unchanged"],
      "promptIntent": "Neutral Illustration translation of the exact Canon."
    },
    {
      "taskId": "task.cross.stylized-3d",
      "label": "stylized-3d",
      "outputSlot": "stylized_3d",
      "delta": [{ "fieldPath": "representation.family", "operation": "select", "value": "stylized_3d", "rationale": "Select only the approved Stylized 3D binding and compile." }],
      "controlChannelIds": ["control.identity.face", "control.body.rhythm", "control.appearance.lock", "control.fixture.lock", "control.representation.binding"],
      "evaluationCriteria": ["Volume translation", "Facial relations", "Silhouette", "Material scope", "Fixture unchanged"],
      "promptIntent": "Neutral stylized-3D-looking image translation; do not claim an actual mesh asset."
    },
    {
      "taskId": "task.cross.hybrid",
      "label": "hybrid",
      "outputSlot": "hybrid",
      "delta": [{ "fieldPath": "representation.family", "operation": "select", "value": "hybrid", "rationale": "Select only the approved scope-based Hybrid binding and compile." }],
      "controlChannelIds": ["control.identity.face", "control.body.rhythm", "control.appearance.lock", "control.fixture.lock", "control.representation.binding"],
      "evaluationCriteria": ["Scope-by-scope coherence", "Canonical relations", "No percentage-blend ambiguity", "Identity marks", "Fixture unchanged"],
      "promptIntent": "Neutral scope-based Hybrid translation of the exact Canon."
    }
  ],
  "assembly": {
    "mode": "deterministic_grid",
    "ordering": ["task.cross.photoreal", "task.cross.anime", "task.cross.manga", "task.cross.illustration", "task.cross.stylized-3d", "task.cross.hybrid"],
    "preserveTaskResolution": true,
    "cropPolicy": "subject_safe",
    "labelMode": "deterministic_text",
    "outputFormat": "png"
  },
  "retryPolicy": {
    "strategy": "failed_tasks_only",
    "maxRetries": 3,
    "preserveSuccessfulTasks": true,
    "stopOnHardFailure": true
  },
  "evaluation": {
    "criteria": ["Semantic facial relations", "Signature silhouette", "Distinctive marks", "Hair identity", "Body rhythm", "Costume cues", "Human same-character judgment"],
    "acceptanceMode": "human_lock"
  },
  "executionBoundary": {
    "providerNeutral": true,
    "generatesMedia": false,
    "humanApprovalRequired": true,
    "notes": "A tile without an exact approved family binding is blocked; successful tiles are preserved and assembled deterministically."
  },
