  "title": "动画人物表现三基准",
  "version": 1,
  "status": "active",
  "ownerSkill": "cineweave-production",
  "category": "technical",
  "outputType": "representation_fixture",
  "purpose": "用中性近景、表演中景和自然全身三套固定夹具验证 Anime 表现中的身份映射、形状语言、线稿、分层明暗、姿态可读性和人物场景统一。",
  "recipeMode": "template",
  "parameters": [
    {
      "name": "qualityBudget",
      "type": "enum",
      "description": "动画表现基准质量预算。",
      "required": true,
      "default": "final",
      "values": ["explore", "final"]
    }
  ],
  "inputSlots": [
    {
      "slotName": "characterSpec",
      "role": "identity",
      "acceptedKinds": ["cineweave_codex_character_spec"],
      "required": true,
      "cardinality": "one",
      "description": "Canonical identity and body rhythm."
    },
    {
      "slotName": "appearanceState",
      "role": "appearance",
      "acceptedKinds": ["cineweave_codex_character_appearance_state"],
      "required": true,
      "cardinality": "one",
      "description": "Exact hair, makeup, costume, accessories and material state."
    },
    {
      "slotName": "representationBinding",
      "role": "representation",
      "acceptedKinds": ["cineweave_codex_representation_binding"],
      "required": true,
      "cardinality": "one",
      "description": "Approved identity translation from Canon into the selected Anime representation."
    },
    {
      "slotName": "styleCompile",
      "role": "style",
      "acceptedKinds": ["cineweave_codex_style_compile"],
      "required": true,
      "cardinality": "one",
      "description": "Scale-aware shape, line, surface, shading, color and depth directives."
    },
    {
      "slotName": "controlSet",
      "role": "control",
      "acceptedKinds": ["cineweave_codex_control_channel_set"],
      "required": true,
      "cardinality": "one",
      "description": "Hard identity, appearance and fixture controls."
    },
    {
      "slotName": "evidenceBundle",
      "role": "evidence",
      "acceptedKinds": ["cineweave_codex_evidence_bundle"],
      "required": true,
      "cardinality": "one",
      "description": "Role-scoped identity, style-family and rights evidence."
    }
  ],
  "layout": {
    "type": "contact_sheet",
    "rows": 1,
    "cols": 3,
    "canvas": { "aspectRatio": "3:1", "sizeClass": "wide" },
    "tileAspectRatio": "3:4",
    "labelPolicy": "outside_tile",
    "cameraConsistency": false,
    "backgroundPolicy": "controlled",
    "lightingPolicy": "controlled"
  },
  "sharedInvariants": [
    "Exact CharacterSpec, AppearanceState and approved RepresentationBinding",
    "One Anime StylePackage and one physical scene-light state across fixtures",
    "No photographic pore requirement and no generic oversized-eye overwrite",
    "No provider-specific style weight or identity strength in Canon"
  ],
  "tasks": [
    {
      "taskId": "task.anime.neutral-close",
      "label": "neutral-close",
      "outputSlot": "neutral_close",
      "delta": [{ "fieldPath": "fixture.profile", "operation": "select", "value": "anime_neutral_close", "rationale": "Select the approved Anime neutral close-up fixture as the sole task delta." }],
      "controlChannelIds": ["control.identity.face", "control.appearance.lock", "control.representation.binding", "control.camera.lock"],
      "evaluationCriteria": ["Identity mapping", "Eye and face abstraction", "Hair shape grouping", "Line hierarchy", "Surface simplification"],
      "promptIntent": "Neutral Anime close-up for identity translation, face design, line and surface checks."
    },
    {
      "taskId": "task.anime.performance-medium",
      "label": "performance-medium",
      "outputSlot": "performance_medium",
      "delta": [{ "fieldPath": "fixture.profile", "operation": "select", "value": "anime_performance_medium", "rationale": "Select the approved Anime performance-medium fixture as the sole task delta." }],
      "controlChannelIds": ["control.identity.face", "control.appearance.lock", "control.representation.binding", "control.performance.fixture", "control.camera.lock"],
      "evaluationCriteria": ["Expression readability", "Identity under expression", "Cel-value grouping", "Pose readability", "No unapproved exaggeration"],
      "promptIntent": "Medium Anime performance fixture with an approved restrained expression and readable key pose."
    },
    {
      "taskId": "task.anime.natural-fullbody",
      "label": "natural-fullbody",
      "outputSlot": "natural_fullbody",
      "delta": [{ "fieldPath": "fixture.profile", "operation": "select", "value": "anime_natural_fullbody", "rationale": "Select the approved Anime full-body fixture as the sole task delta." }],
      "controlChannelIds": ["control.identity.face", "control.body.rhythm", "control.appearance.lock", "control.representation.binding", "control.camera.lock"],
      "evaluationCriteria": ["Adult body rhythm", "Silhouette", "Costume simplification", "Grounded pose", "Character-background integration"],
      "promptIntent": "Full-body Anime fixture for silhouette, proportion, costume translation and environmental integration."
    }
  ],
  "assembly": {
    "mode": "deterministic_grid",
    "ordering": ["task.anime.neutral-close", "task.anime.performance-medium", "task.anime.natural-fullbody"],
    "preserveTaskResolution": true,
    "cropPolicy": "subject_safe",
    "labelMode": "deterministic_text",
    "outputFormat": "png"
  },
  "retryPolicy": {
    "strategy": "failed_tasks_only",
    "maxRetries": 3,
    "preserveSuccessfulTasks": true,
    "stopOnHardFailure": true
  },
  "evaluation": {
    "criteria": ["Identity mapping", "Geometry abstraction", "Line hierarchy", "Shading", "Palette", "Expression", "Silhouette", "Background integration"],
    "acceptanceMode": "human_lock"
  },
  "executionBoundary": {
