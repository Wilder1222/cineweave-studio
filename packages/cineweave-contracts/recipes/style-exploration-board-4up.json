{
  "kind": "cineweave_codex_asset_recipe",
  "contractVersion": "2.0.0",
  "worldId": "world-template",
  "recipeId": "recipe.style-exploration-board-4up",
  "title": "视觉风格单轴探索四候选板",
  "version": 1,
  "status": "active",
  "ownerSkill": "cineweave-style",
  "category": "technical",
  "outputType": "style_exploration",
  "purpose": "在完全相同的角色、造型、场景、动作、镜头和物理光源条件下，独立比较四个仅改变一个风格轴的候选。",
  "recipeMode": "template",
  "parameters": [
    {
      "name": "qualityBudget",
      "type": "enum",
      "description": "风格探索质量预算。",
      "required": true,
      "default": "explore",
      "values": ["draft", "explore", "final"]
    }
  ],
  "inputSlots": [
    {
      "slotName": "explorationBrief",
      "role": "style",
      "acceptedKinds": ["cineweave_codex_style_exploration_brief"],
      "required": true,
      "cardinality": "one",
      "description": "固定 Canon、共享测试夹具、单一主探索轴和人工选择策略。"
    },
    {
      "slotName": "optionSet",
      "role": "style",
      "acceptedKinds": ["cineweave_codex_style_option_set"],
      "required": true,
      "cardinality": "one",
      "description": "按源顺序提供最多四个可比较候选；每个候选只能声明一个主差异。"
    },
    {
      "slotName": "characterSpec",
      "role": "identity",
      "acceptedKinds": ["cineweave_codex_character_spec"],
      "required": true,
      "cardinality": "one",
      "description": "All candidates share this exact Canonical Character."
    },
    {
      "slotName": "appearanceState",
      "role": "appearance",
      "acceptedKinds": ["cineweave_codex_character_appearance_state"],
      "required": true,
      "cardinality": "one",
      "description": "All candidates share this exact appearance construction."
    },
    {
      "slotName": "sceneSpec",
      "role": "scene",
      "acceptedKinds": ["cineweave_codex_scene_spec"],
      "required": true,
      "cardinality": "one",
      "description": "All candidates share this exact scene geography and physical facts."
    },
    {
      "slotName": "controlSet",
      "role": "control",
      "acceptedKinds": ["cineweave_codex_control_channel_set"],
      "required": true,
      "cardinality": "one",
      "description": "锁定角色、造型、场景、表演、镜头、背景与物理光源。"
    },
    {
      "slotName": "evidenceBundle",
      "role": "evidence",
      "acceptedKinds": ["cineweave_codex_evidence_bundle"],
      "required": false,
      "cardinality": "zero_or_one",
      "description": "可选的 role-scoped 风格证据与权利状态；没有证据时不得伪造观察。"
    }
  ],
  "layout": {
    "type": "contact_sheet",
    "rows": 2,
    "cols": 2,
    "canvas": { "aspectRatio": "1:1", "sizeClass": "square" },
    "tileAspectRatio": "3:4",
    "labelPolicy": "outside_tile",
    "cameraConsistency": true,
    "backgroundPolicy": "locked",
    "lightingPolicy": "locked"
  },
  "sharedInvariants": [
    "Exact sharedFixture from StyleExplorationBrief",
    "Exact CharacterSpec, AppearanceState, scene, action, camera and physical light-source state",
    "One shared primary exploration axis across all options",
    "No named creator or work is treated as canonical evidence",
    "No option is ranked or activated without human selection"
  ],
  "tasks": [
    {
      "taskId": "task.style.option-01",
      "label": "style-option-01",
      "outputSlot": "style_option_01",
      "delta": [{ "fieldPath": "styleOptionSet.options", "operation": "select", "value": "source_order_01", "rationale": "Select only the first option and its one approved primary delta." }],
      "controlChannelIds": ["control.identity.face", "control.appearance.lock", "control.fixture.lock", "control.camera.lock", "control.style.option"],
      "evaluationCriteria": ["Canon unchanged", "Primary style delta readable", "No secondary-axis drift", "Fixture unchanged"],
      "promptIntent": "Compile source-order style option 01 against the exact shared fixture."
    },
    {
      "taskId": "task.style.option-02",
      "label": "style-option-02",
      "outputSlot": "style_option_02",
      "delta": [{ "fieldPath": "styleOptionSet.options", "operation": "select", "value": "source_order_02", "rationale": "Select only the second option and its one approved primary delta." }],
      "controlChannelIds": ["control.identity.face", "control.appearance.lock", "control.fixture.lock", "control.camera.lock", "control.style.option"],
      "evaluationCriteria": ["Canon unchanged", "Primary style delta readable", "No secondary-axis drift", "Fixture unchanged"],
      "promptIntent": "Compile source-order style option 02 against the exact shared fixture."
    },
    {
      "taskId": "task.style.option-03",
      "label": "style-option-03",
      "outputSlot": "style_option_03",
      "delta": [{ "fieldPath": "styleOptionSet.options", "operation": "select", "value": "source_order_03", "rationale": "Select only the third option and its one approved primary delta." }],
      "controlChannelIds": ["control.identity.face", "control.appearance.lock", "control.fixture.lock", "control.camera.lock", "control.style.option"],
      "evaluationCriteria": ["Canon unchanged", "Primary style delta readable", "No secondary-axis drift", "Fixture unchanged"],
      "promptIntent": "Compile source-order style option 03 against the exact shared fixture."
    },
    {
      "taskId": "task.style.option-04",
      "label": "style-option-04",
      "outputSlot": "style_option_04",
      "delta": [{ "fieldPath": "styleOptionSet.options", "operation": "select", "value": "source_order_04", "rationale": "Select only the fourth option and its one approved primary delta." }],
      "controlChannelIds": ["control.identity.face", "control.appearance.lock", "control.fixture.lock", "control.camera.lock", "control.style.option"],
      "evaluationCriteria": ["Canon unchanged", "Primary style delta readable", "No secondary-axis drift", "Fixture unchanged"],
      "promptIntent": "Compile source-order style option 04 against the exact shared fixture."
    }
  ],
  "assembly": {
    "mode": "deterministic_grid",
    "ordering": ["task.style.option-01", "task.style.option-02", "task.style.option-03", "task.style.option-04"],
    "preserveTaskResolution": true,
    "cropPolicy": "subject_safe",
    "labelMode": "deterministic_text",
    "outputFormat": "png"
  },
  "retryPolicy": {
    "strategy": "failed_tasks_only",
    "maxRetries": 3,
    "preserveSuccessfulTasks": true,
    "stopOnHardFailure": true
  },
  "evaluation": {
    "criteria": ["Canon preservation", "Single-axis comparability", "Style hypothesis visibility", "Reference-scope compliance", "Human preference readiness"],
    "acceptanceMode": "human_lock"
  },
  "executionBoundary": {
