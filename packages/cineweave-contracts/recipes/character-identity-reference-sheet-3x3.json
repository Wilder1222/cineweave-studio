{
  "kind": "cineweave_codex_asset_recipe",
  "contractVersion": "2.0.0",
  "worldId": "world-template",
  "recipeId": "recipe.character-identity-reference-sheet-3x3",
  "title": "角色身份与服饰细节九宫格",
  "version": 1,
  "status": "active",
  "ownerSkill": "cineweave-production",
  "category": "character",
  "outputType": "identity_reference",
  "purpose": "以九个独立可重试的近景、中景和全身 Tile 记录同一角色的面部、头饰、服装、手部材质、轮廓与受控动态；与正侧背三视图配合，而不把异构内容交给单次多面板生成。",
  "recipeMode": "template",
  "parameters": [
    {
      "name": "qualityBudget",
      "type": "enum",
      "description": "角色设定参考的质量预算。",
      "required": true,
      "default": "explore",
      "values": ["draft", "explore", "final"]
    },
    {
      "name": "detailTheme",
      "type": "string",
      "description": "服饰或材质的可见主题，例如水袖、盔甲、礼服或现代时装。",
      "required": false,
      "default": "approved appearance state"
    }
  ],
  "inputSlots": [
    {
      "slotName": "characterSpec",
      "role": "identity",
      "acceptedKinds": ["cineweave_codex_character_spec"],
      "required": true,
      "cardinality": "one",
      "description": "锁定的角色身份事实与可见锚点。"
    },
    {
      "slotName": "appearanceState",
      "role": "appearance",
      "acceptedKinds": ["cineweave_codex_character_appearance_state"],
      "required": false,
      "cardinality": "zero_or_one",
      "description": "已批准的妆发、服装、首饰和可变表面状态。"
    },
    {
      "slotName": "representationBinding",
      "role": "representation",
      "acceptedKinds": ["cineweave_codex_representation_binding"],
      "required": false,
      "cardinality": "zero_or_one",
      "description": "需要跨表征角色一致性时使用的精确身份翻译绑定。"
    },
    {
      "slotName": "styleCompile",
      "role": "style",
      "acceptedKinds": ["cineweave_codex_style_compile"],
      "required": false,
      "cardinality": "zero_or_one",
      "description": "可选的已编译表征与材质处理；不得覆写身份或服装事实。"
    },
    {
      "slotName": "controlSet",
      "role": "control",
      "acceptedKinds": ["cineweave_codex_control_channel_set"],
      "required": true,
      "cardinality": "one",
      "description": "身份、形态、外观和相机控制优先级。"
    },
    {
      "slotName": "evidenceBundle",
      "role": "evidence",
      "acceptedKinds": ["cineweave_codex_evidence_bundle"],
      "required": true,
      "cardinality": "one",
      "description": "角色身份、服装、材质和权利的角色化证据。"
    }
  ],
  "layout": {
    "type": "contact_sheet",
    "rows": 3,
    "cols": 3,
    "canvas": { "aspectRatio": "1:1", "sizeClass": "square" },
    "tileAspectRatio": "1:1",
    "labelPolicy": "outside_tile",
    "cameraConsistency": false,
    "backgroundPolicy": "locked",
    "lightingPolicy": "controlled"
  },
  "sharedInvariants": [
    "同一 CharacterSpec、AppearanceState、身份锚点、头身比例、妆发和服装结构保持一致",
    "每个 Tile 独立生成、独立评审、只重试失败 Tile",
    "背景保持中性且不与人物或服装细节竞争；光线只在材料可读性范围内变化",
    "文字、网格、标签和最终设定板版式由外部确定性组装器添加，不由图像模型生成"
  ],
  "tasks": [
    {
      "taskId": "task.identity-detail.face-front",
      "label": "face-front",
      "outputSlot": "face_front",
      "delta": [{ "fieldPath": "fixture.detailSlot", "operation": "select", "value": "face_front", "rationale": "只选择正面定妆面部细节。" }],
      "controlChannelIds": ["control.identity.face", "control.appearance.lock", "control.camera.lock"],
      "evaluationCriteria": ["面部识别锚点完整", "妆容可读", "不改变年龄或比例"],
      "promptIntent": "Neutral front face detail with the approved makeup, hairline and visible accessories; no beauty-filter identity drift."
    },
    {
      "taskId": "task.identity-detail.face-three-quarter",
      "label": "face-three-quarter",
      "outputSlot": "face_three_quarter",
      "delta": [{ "fieldPath": "fixture.detailSlot", "operation": "select", "value": "face_three_quarter", "rationale": "只选择四分之三面部结构视图。" }],
      "controlChannelIds": ["control.identity.face", "control.appearance.lock", "control.camera.lock"],
      "evaluationCriteria": ["眼鼻唇下颌关系清晰", "发型和耳饰连接可信", "不改变身份"],
      "promptIntent": "Three-quarter face detail that reveals approved facial relations, hairline, ear adornment and jaw transition."
    },
    {
      "taskId": "task.identity-detail.face-profile",
      "label": "face-profile",
      "outputSlot": "face_profile",
      "delta": [{ "fieldPath": "fixture.detailSlot", "operation": "select", "value": "face_profile", "rationale": "只选择九十度侧脸结构视图。" }],
      "controlChannelIds": ["control.identity.face", "control.appearance.lock", "control.camera.lock"],
      "evaluationCriteria": ["轮廓与正面一致", "额头鼻梁唇颏关系可读", "头饰侧面可检查"],
      "promptIntent": "Strict profile face detail; show a coherent forehead, nose, lips, chin, curled fringe and side thickness of headwear."
    },
    {
      "taskId": "task.identity-detail.hair-headwear",
      "label": "hair-headwear",
      "outputSlot": "hair_headwear",
      "delta": [{ "fieldPath": "fixture.detailSlot", "operation": "select", "value": "hair_headwear", "rationale": "只选择发型、头饰和耳饰构造。" }],
      "controlChannelIds": ["control.identity.face", "control.appearance.lock", "control.material.detail"],
      "evaluationCriteria": ["发丝、冠饰、花饰和飘带结构可读", "左右不对称受控", "不遮挡关键面部"],
      "promptIntent": "Head-and-shoulders construction detail for hair, headwear, flowers, ribbons and earrings with believable attachment points."
    },
    {
      "taskId": "task.identity-detail.shoulder-bodice",
      "label": "shoulder-bodice",
      "outputSlot": "shoulder_bodice",
      "delta": [{ "fieldPath": "fixture.detailSlot", "operation": "select", "value": "shoulder_bodice", "rationale": "只选择肩饰、胸衣和领口构造。" }],
      "controlChannelIds": ["control.appearance.lock", "control.material.detail", "control.camera.lock"],
      "evaluationCriteria": ["层次和固定方式可见", "金属、珠饰、织物反应分离", "服装不变形"],
      "promptIntent": "Shoulder-to-waist costume detail that exposes layer order, embroidery, beadwork, closures and material differences."
    },
    {
      "taskId": "task.identity-detail.hand-sleeve-material",
      "label": "hand-sleeve-material",
      "outputSlot": "hand_sleeve_material",
      "delta": [{ "fieldPath": "fixture.detailSlot", "operation": "select", "value": "hand_sleeve_material", "rationale": "只选择手部、衣袖和半透明材质。" }],
      "controlChannelIds": ["control.identity.face", "control.appearance.lock", "control.material.detail", "control.hand.anatomy"],
      "evaluationCriteria": ["手部结构可信", "布料层叠与透光可读", "无多余手指或穿模"],
      "promptIntent": "Hands and sleeve-material detail with anatomically coherent fingers, believable grasp/gesture and physically readable translucent textile layers."
    },
    {
      "taskId": "task.identity-detail.fullbody-silhouette",
      "label": "fullbody-silhouette",
      "outputSlot": "fullbody_silhouette",
      "delta": [{ "fieldPath": "fixture.detailSlot", "operation": "select", "value": "fullbody_silhouette", "rationale": "只选择完整站立轮廓和鞋履。" }],
      "controlChannelIds": ["control.identity.face", "control.body.rhythm", "control.appearance.lock", "control.camera.lock"],
      "evaluationCriteria": ["头身比、衣长、鞋履和接触关系可读", "身体完整可见", "自然承重"],
      "promptIntent": "Natural full-body standing silhouette with visible feet, garment length, footwear and grounded support."
    },
    {
      "taskId": "task.identity-detail.costume-motion",
      "label": "costume-motion",
      "outputSlot": "costume_motion",
      "delta": [{ "fieldPath": "fixture.detailSlot", "operation": "select", "value": "costume_motion", "rationale": "只选择受控动态下的服装外轮廓。" }],
      "controlChannelIds": ["control.body.rhythm", "control.appearance.lock", "control.performance.fixture", "control.material.detail"],
      "evaluationCriteria": ["动作不改身份", "服装受重力和风的响应可信", "动态不遮挡关键结构"],
      "promptIntent": "One restrained character-specific pose that reveals costume silhouette and controlled secondary cloth motion without changing identity."
    },
    {
      "taskId": "task.identity-detail.mood-portrait",
      "label": "mood-portrait",
      "outputSlot": "mood_portrait",
      "delta": [{ "fieldPath": "fixture.detailSlot", "operation": "select", "value": "mood_portrait", "rationale": "只选择受控情绪和整体造型的角色肖像。" }],
      "controlChannelIds": ["control.identity.face", "control.appearance.lock", "control.performance.fixture", "control.camera.lock"],
      "evaluationCriteria": ["角色气质可读", "身份和造型锚点保持", "不把情绪变化变成年龄或脸型变化"],
      "promptIntent": "Controlled mood portrait with a restrained approved expression; preserve the same face, hairstyle, headwear and costume identity."
    }
  ],
  "assembly": {
    "mode": "deterministic_grid",
    "ordering": [
      "task.identity-detail.face-front",
      "task.identity-detail.face-three-quarter",
      "task.identity-detail.face-profile",
      "task.identity-detail.hair-headwear",
      "task.identity-detail.shoulder-bodice",
      "task.identity-detail.hand-sleeve-material",
      "task.identity-detail.fullbody-silhouette",
      "task.identity-detail.costume-motion",
      "task.identity-detail.mood-portrait"
    ],
    "preserveTaskResolution": true,
    "cropPolicy": "subject_safe",
    "labelMode": "deterministic_text",
    "outputFormat": "png"
  },
  "retryPolicy": {
    "strategy": "failed_tasks_only",
    "maxRetries": 3,
    "preserveSuccessfulTasks": true,
    "stopOnHardFailure": true
  },
  "evaluation": {
    "criteria": ["身份跨 Tile 一致", "服装结构和材质可读", "手部与全身结构可信", "细节槽位覆盖完整"],
    "acceptanceMode": "human_lock"
  },
  "executionBoundary": {
    "providerNeutral": true,
    "generatesMedia": false,
    "humanApprovalRequired": true,
    "notes": "配方只编排独立角色细节任务；最终设定板的异构区域由 BoardAssemblyPlan 和外部确定性组装器完成。"
  },
  "skillReceipt": {
