    "createdAt": "2026-08-22T13:00:00.000Z",
    "updatedAt": "2026-08-22T13:00:00.000Z",
    "changeLog": ["v1: independent 3x3 identity, costume and material detail recipe for deterministic character reference sheets"]
  }
}
