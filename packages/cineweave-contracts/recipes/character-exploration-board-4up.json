  "title": "人物身份探索四候选板",
  "version": 1,
  "status": "active",
  "ownerSkill": "cineweave-character",
  "category": "character",
  "outputType": "keyframe_board",
  "purpose": "在相同中性测试夹具下比较四个角色身份假设；每张 Tile 独立生成，只改变一个主探索变量。",
  "recipeMode": "template",
  "parameters": [
    {
      "name": "qualityBudget",
      "type": "enum",
      "description": "候选探索预算",
      "required": true,
      "default": "explore",
      "values": ["draft", "explore", "final"]
    }
  ],
  "inputSlots": [
    {
      "slotName": "explorationBrief",
      "role": "generic",
      "acceptedKinds": ["cineweave_codex_character_exploration_brief"],
      "required": true,
      "cardinality": "one",
      "description": "用户感受、探索轴、共享测试夹具与锁定状态。"
    },
    {
      "slotName": "optionSet",
      "role": "identity",
      "acceptedKinds": ["cineweave_codex_character_option_set"],
      "required": true,
      "cardinality": "one",
      "description": "可比较的身份候选；不得用生成结果反向改写其中的候选语义。"
    },
    {
      "slotName": "controlSet",
      "role": "control",
      "acceptedKinds": ["cineweave_codex_control_channel_set"],
      "required": true,
      "cardinality": "one",
      "description": "将共享测试夹具和单变量变化作为高优先级控制。"
    },
    {
      "slotName": "evidenceBundle",
      "role": "evidence",
      "acceptedKinds": ["cineweave_codex_evidence_bundle"],
      "required": false,
      "cardinality": "zero_or_one",
      "description": "可选的权利与现有身份证据；首次零提示词探索不应伪造观察证据。"
    }
  ],
  "layout": {
    "type": "contact_sheet",
    "rows": 2,
    "cols": 2,
    "canvas": {
      "aspectRatio": "1:1",
      "sizeClass": "square"
    },
    "tileAspectRatio": "2:3",
    "labelPolicy": "outside_tile",
    "cameraConsistency": true,
    "backgroundPolicy": "locked",
    "lightingPolicy": "locked"
