{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-studio/schemas/prompt-repair.schema.json",
  "title": "CineWeave Prompt Repair",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "contractVersion", "repairId", "version", "parentPromptRef", "skillReceipt", "observedFailure", "evidenceObservationIds", "ownerPath", "preserve", "changeOnly", "target", "acceptanceChecks", "stopCondition", "validation"],
  "properties": {
    "kind": { "const": "cineweave_codex_prompt_repair" },
    "contractVersion": { "const": "2.2.0" },
    "repairId": { "$ref": "common.schema.json#/$defs/identifier" },
    "version": { "type": "integer", "minimum": 1 },
    "parentPromptRef": { "$ref": "common.schema.json#/$defs/contractRef" },
    "skillReceipt": { "$ref": "common.schema.json#/$defs/skillReceipt" },
    "observedFailure": { "type": "string", "minLength": 1, "maxLength": 1600 },
    "evidenceObservationIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "common.schema.json#/$defs/identifier" }
    },
    "ownerPath": {
      "enum": [
        "prompt.subject",
        "prompt.action",
        "prompt.environment",
        "prompt.composition",
        "prompt.camera",
        "prompt.lighting",
        "prompt.materials",
        "prompt.style",
        "prompt.technical",
        "prompt.constraints",
        "reference.binding"
      ]
    },
    "preserve": { "$ref": "common.schema.json#/$defs/stringList" },
    "changeOnly": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "target": { "type": "string", "minLength": 1, "maxLength": 1600 },
    "acceptanceChecks": { "$ref": "common.schema.json#/$defs/stringList" },
    "stopCondition": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["singleVariable", "parentImmutable", "evidenceBound", "providerNeutral"],
      "properties": {
        "singleVariable": { "const": true },
        "parentImmutable": { "const": true },
        "evidenceBound": { "const": true },
        "providerNeutral": { "const": true }
      }
    }
  }
}
