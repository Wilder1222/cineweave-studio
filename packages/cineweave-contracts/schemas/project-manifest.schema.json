{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-studio/schemas/project-manifest.schema.json",
  "title": "CineWeave Local Project Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "contractVersion", "projectId", "name", "createdAt", "runtimeVersion", "storage"],
  "properties": {
    "kind": { "const": "cineweave_project_manifest" },
    "contractVersion": { "enum": ["2.2.0", "2.3.0", "2.3.1"] },
    "projectId": { "$ref": "common.schema.json#/$defs/identifier" },
    "name": { "type": "string", "minLength": 1, "maxLength": 240 },
    "createdAt": { "type": "string", "format": "date-time" },
    "runtimeVersion": { "enum": ["2.2.0", "2.3.0", "2.3.1"] },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "artifactDirectory", "approvalDirectory"],
      "properties": {
        "mode": { "const": "local_immutable" },
        "artifactDirectory": { "const": "artifacts" },
        "approvalDirectory": { "const": "approvals" },
        "executionDirectory": { "const": "executions" },
        "idempotencyDirectory": { "const": "idempotency" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "contractVersion": { "const": "2.2.0" } },
        "required": ["contractVersion"]
      },
      "then": {
        "properties": { "runtimeVersion": { "const": "2.2.0" } }
      }
    },
    {
      "if": {
        "properties": { "contractVersion": { "const": "2.3.0" } },
        "required": ["contractVersion"]
      },
      "then": {
        "properties": {
          "runtimeVersion": { "const": "2.3.0" },
          "storage": {
            "required": ["executionDirectory", "idempotencyDirectory"]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "contractVersion": { "const": "2.3.1" } },
        "required": ["contractVersion"]
      },
      "then": {
        "properties": {
          "runtimeVersion": { "const": "2.3.1" },
          "storage": {
            "required": ["executionDirectory", "idempotencyDirectory"]
          }
        }
      }
    }
  ]
}
