{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-studio/schemas/control-benchmark.schema.json",
  "title": "CineWeave ControlBench Suite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "suiteId",
    "title",
    "version",
    "status",
    "skillReceipt",
    "purpose",
    "scopes",
    "dimensions",
    "metrics",
    "cases",
    "humanReview",
    "acceptance",
    "executionBoundary",
    "validation",
    "provenance"
  ],
  "properties": {
    "kind": {
      "const": "cineweave_codex_control_benchmark"
    },
    "contractVersion": {
      "const": "2.0.0"
    },
    "suiteId": {
      "$ref": "#/$defs/lowerId"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "archived"
      ]
    },
    "skillReceipt": {
      "$ref": "#/$defs/skillReceipt"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/dimension"
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/metric"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "humanReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredForBlockingDimensions",
        "rubric",
        "reviewerCount"
      ],
      "properties": {
        "requiredForBlockingDimensions": {
          "const": true
        },
        "rubric": {
          "$ref": "#/$defs/stringList"
        },
        "reviewerCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumCasePassRate",
        "blockingDimensionPassRate",
        "allRightsCasesPass"
      ],
      "properties": {
        "minimumCasePassRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "blockingDimensionPassRate": {
          "const": 1
        },
        "allRightsCasesPass": {
          "const": true
        }
      }
    },
    "executionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerNeutral",
        "generatesMedia",
        "humanApprovalRequired"
      ],
      "properties": {
        "providerNeutral": {
          "const": true
        },
        "generatesMedia": {
          "const": false
        },
        "humanApprovalRequired": {
          "const": true
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metricRefsResolved",
        "recipeRefsResolved",
        "controlRefsResolved",
        "evidenceRefsResolved",
        "rightsCasesIncluded"
      ],
      "properties": {
        "metricRefsResolved": {
          "const": true
        },
        "recipeRefsResolved": {
          "const": true
        },
        "controlRefsResolved": {
          "const": true
        },
        "evidenceRefsResolved": {
          "const": true
        },
        "rightsCasesIncluded": {
          "const": true
        }
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "skillReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "ref",
        "commit",
        "installedBy",
        "usedAt"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(www\\.)?github\\.com/[^/]+/[^/]+(?:\\.git)?/?$"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "installedBy": {
          "const": "codex-environment"
        },
        "environmentId": {
          "type": "string",
          "maxLength": 240
        },
        "usedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{1,159}$"
    },
    "lowerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
    },
    "observationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "not": {
        "pattern": "(?:https?:|file:|[\\\\/?#])"
      }
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1600
      }
    },
    "optionalStringList": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1600
      }
    },
    "primitive": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "createdAt",
        "updatedAt",
        "changeLog"
      ],
      "properties": {
        "source": {
          "enum": [
            "user_authored",
            "codex_authored",
            "adapted",
            "imported",
            "suite_builtin"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "parentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "changeLog": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "versionedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "$ref": "#/$defs/contentHash"
        },
        "observationIds": {
          "type": "array",
          "maxItems": 24,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/observationId"
          }
        }
      }
    },
    "contractRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "contentHash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "$ref": "#/$defs/contentHash"
        }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aspectRatio",
        "sizeClass"
      ],
      "properties": {
        "aspectRatio": {
          "type": "string",
          "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"
        },
        "sizeClass": {
          "enum": [
            "square",
            "portrait",
            "landscape",
            "wide",
            "tall",
            "custom",
            "unspecified"
          ]
        },
        "pixelDimensions": {
          "type": "string",
          "pattern": "^[1-9][0-9]*x[1-9][0-9]*$"
        },
        "background": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimensionId",
        "scope",
        "description",
        "severity",
        "metricIds"
      ],
      "properties": {
        "dimensionId": {
          "$ref": "#/$defs/stableId"
        },
        "scope": {
          "enum": [
            "character",
            "appearance",
            "scene",
            "interaction",
            "storyboard",
            "cinematography",
            "rights",
            "production"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "severity": {
          "enum": [
            "advisory",
            "important",
            "blocking"
          ]
        },
        "metricIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metricId",
        "type",
        "description",
        "direction",
        "passThreshold"
      ],
      "properties": {
        "metricId": {
          "$ref": "#/$defs/stableId"
        },
        "type": {
          "enum": [
            "rule",
            "embedding",
            "pose",
            "segmentation",
            "layout",
            "temporal",
            "vlm",
            "human"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "direction": {
          "enum": [
            "higher_is_better",
            "lower_is_better",
            "boolean"
          ]
        },
        "passThreshold": {
          "type": [
            "number",
            "boolean"
          ]
        },
        "range": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "category",
        "recipeRef",
        "controlSetRef",
        "evidenceBundleRef",
        "perturbation",
        "expectedInvariants",
        "expectedAllowedChanges",
        "failureLabels",
        "repetitions",
        "humanReviewRequired"
      ],
      "properties": {
        "caseId": {
          "$ref": "#/$defs/stableId"
        },
        "category": {
          "enum": [
            "character_identity",
            "appearance",
            "expression",
            "pose",
            "scene_state",
            "scene_layout",
            "interaction",
            "storyboard_continuity",
            "cinematography",
            "rights"
          ]
        },
        "recipeRef": {
          "$ref": "#/$defs/contractRef"
        },
        "controlSetRef": {
          "$ref": "#/$defs/contractRef"
        },
        "evidenceBundleRef": {
          "$ref": "#/$defs/contractRef"
        },
        "perturbation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "expectedInvariants": {
          "$ref": "#/$defs/stringList"
        },
        "expectedAllowedChanges": {
          "$ref": "#/$defs/stringList"
        },
        "failureLabels": {
          "$ref": "#/$defs/stringList"
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "humanReviewRequired": {
          "type": "boolean"
        }
      }
    }
  }
}
