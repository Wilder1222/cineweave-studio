{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-studio/schemas/reference-set.schema.json",
  "title": "CineWeave Codex Semantic Reference Set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "worldId",
    "skillReceipt",
    "purpose",
    "references",
    "validation"
  ],
  "properties": {
    "contractVersion": {
      "const": "2.0.0"
    },
    "kind": {
      "const": "cineweave_codex_reference_set"
    },
    "worldId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "skillReceipt": {
      "$ref": "#/$defs/skillReceipt"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scopeChecked",
        "noPrivateUrls",
        "noSecrets"
      ],
      "properties": {
        "scopeChecked": {
          "const": true
        },
        "noPrivateUrls": {
          "const": true
        },
        "noSecrets": {
          "const": true
        },
        "roleConflictsChecked": {
          "type": "boolean"
        }
      }
    },
    "evidenceBundleRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "contentHash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        }
      }
    },
    "licenseProfileRefs": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "contentHash"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "contentHash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-fA-F]{64}$"
          }
        }
      }
    }
  },
  "$defs": {
    "skillReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "ref",
        "commit",
        "installedBy",
        "usedAt"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(www\\.)?github\\.com/[^/]+/[^/]+(?:\\.git)?/?$"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "installedBy": {
          "const": "codex-environment"
        },
        "environmentId": {
          "type": "string",
          "maxLength": 240
        },
        "usedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1200
      }
    },
    "scope": {
      "enum": [
        "full_character",
        "face",
        "skin",
        "body",
        "costume",
        "prop",
        "expression",
        "pose",
        "motion",
        "capture",
        "environment",
        "lighting",
        "material",
        "composition",
        "style",
        "mask",
        "generic",
        "architecture",
        "geography",
        "prop_layout",
        "weather",
        "atmosphere",
        "crowd",
        "damage",
        "camera_axis",
        "scale"
      ]
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observationId",
        "role",
        "sourceType",
        "preserve",
        "allowedTransforms"
      ],
      "properties": {
        "observationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "observationRef": {
          "$ref": "common.schema.json#/$defs/contractRef"
        },
        "assetRef": {
          "$ref": "common.schema.json#/$defs/contractRef"
        },
        "role": {
          "enum": [
            "identity",
            "face_identity",
            "body_identity",
            "appearance",
            "skin_material",
            "makeup",
            "hair",
            "costume",
            "performance",
            "capture",
            "composition",
            "lighting",
            "style",
            "material",
            "background",
            "mask",
            "reference",
            "geography",
            "prop_layout",
            "atmosphere"
          ]
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "sourceType": {
          "enum": [
            "world_observation",
            "user_upload",
            "candidate_media"
          ]
        },
        "sourceLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "characterSpecRef": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,159}@[1-9][0-9]*$"
        },
        "preserve": {
          "$ref": "#/$defs/stringList"
        },
        "allowedTransforms": {
          "$ref": "#/$defs/stringList"
        },
        "excluded": {
          "$ref": "#/$defs/stringList"
        },
        "sceneSpecRef": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,159}@[1-9][0-9]*$"
        },
        "assetOwner": {
          "enum": [
            "character",
            "scene",
            "world",
            "shot"
          ]
        },
        "licenseProfileRef": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "contentHash"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "contentHash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-fA-F]{64}$"
            }
          }
        }
      }
    }
  }
}
