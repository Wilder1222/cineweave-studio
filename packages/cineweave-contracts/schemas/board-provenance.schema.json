{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-studio/schemas/board-provenance.schema.json",
  "title": "CineWeave Deterministic Board Provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "contractVersion", "boardId", "manifestHash", "boardHash", "failedTileIds", "tiles"],
  "properties": {
    "kind": { "const": "cineweave_board_provenance" },
    "contractVersion": { "enum": ["2.2.0", "2.3.0", "2.3.1", "2.4.0", "2.5.0"] },
    "boardId": { "$ref": "common.schema.json#/$defs/identifier" },
    "manifestHash": { "$ref": "common.schema.json#/$defs/contentHash" },
    "boardHash": { "$ref": "common.schema.json#/$defs/contentHash" },
    "failedTileIds": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/identifier" }
    },
    "tiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "sourcePath", "contentHash"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/identifier" },
          "status": { "enum": ["ready", "failed"] },
          "sourcePath": { "type": ["string", "null"], "maxLength": 500 },
          "contentHash": {
            "anyOf": [
              { "$ref": "common.schema.json#/$defs/contentHash" },
              { "type": "null" }
            ]
          },
          "recipeRunId": { "$ref": "common.schema.json#/$defs/identifier" },
          "taskId": { "$ref": "common.schema.json#/$defs/identifier" },
          "regionId": { "$ref": "common.schema.json#/$defs/identifier" }
        }
      }
    }
  }
}
