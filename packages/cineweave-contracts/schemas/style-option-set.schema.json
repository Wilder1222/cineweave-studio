{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-studio/schemas/style-option-set.schema.json",
  "title": "CineWeave Style Option Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "contractVersion", "worldId", "optionSetId", "status", "explorationBriefRef", "sharedFixtureFingerprint", "explorationAxis", "options", "selectionPolicy", "executionBoundary", "validation", "skillReceipt"],
  "properties": {
    "kind": { "const": "cineweave_codex_style_option_set" },
    "contractVersion": { "const": "2.5.0" },
    "worldId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "optionSetId": { "$ref": "#/$defs/lowerId" },
    "status": { "enum": ["draft", "ready_for_generation", "reviewing", "converged", "archived"] },
    "explorationBriefRef": { "$ref": "#/$defs/briefRef" },
    "sharedFixtureFingerprint": { "$ref": "#/$defs/contentHash" },
    "explorationAxis": { "$ref": "#/$defs/styleAxis" },
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/option" }
    },
    "selectionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiresHumanSelection", "maxSelectedOptions", "onePrimaryDeltaPerOption", "activationRequiresStylePackageGate"],
      "properties": {
        "requiresHumanSelection": { "const": true },
        "maxSelectedOptions": { "type": "integer", "minimum": 1, "maximum": 2 },
        "onePrimaryDeltaPerOption": { "const": true },
        "activationRequiresStylePackageGate": { "const": true }
      }
    },
    "executionBoundary": { "$ref": "#/$defs/executionBoundary" },
    "validation": { "$ref": "#/$defs/validation" },
    "skillReceipt": { "$ref": "#/$defs/skillReceipt" }
  },
  "$defs": {
    "lowerId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$" },
    "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" },
    "stringList": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 1200 } },
    "styleAxis": { "enum": ["representation", "geometry", "shape_language", "linework", "surface", "shading", "color", "lighting", "depth", "composition", "performance", "motion", "effects", "postprocess"] },
    "briefRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "version", "contentHash"],
      "properties": {
        "kind": { "const": "cineweave_codex_style_exploration_brief" },
        "id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "version": { "type": "integer", "minimum": 1 },
        "contentHash": { "$ref": "#/$defs/contentHash" }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["optionId", "displayName", "summary", "primaryDelta", "styleHypothesis", "preserve", "forbidden", "promptIntent", "status"],
      "properties": {
        "optionId": { "$ref": "#/$defs/lowerId" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 240 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "primaryDelta": {
          "type": "object",
          "additionalProperties": false,
          "required": ["axis", "direction", "observableHypothesis"],
          "properties": {
            "axis": { "$ref": "#/$defs/styleAxis" },
            "direction": { "type": "string", "minLength": 1, "maxLength": 800 },
            "observableHypothesis": { "type": "string", "minLength": 1, "maxLength": 1200 }
          }
        },
        "styleHypothesis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["medium", "representationFamily", "visualGrammar", "temporalUnknowns"],
          "properties": {
            "medium": { "enum": ["live_action", "hand_drawn_2d", "digital_2d", "comic", "illustration", "three_d", "mixed"] },
            "representationFamily": { "enum": ["photoreal", "anime", "manga", "illustration", "stylized_3d", "hybrid"] },
            "visualGrammar": { "$ref": "#/$defs/stringList" },
            "temporalUnknowns": { "$ref": "#/$defs/stringList" }
          }
        },
        "preserve": { "$ref": "#/$defs/stringList" },
        "forbidden": { "$ref": "#/$defs/stringList" },
        "promptIntent": { "type": "string", "minLength": 1, "maxLength": 2400 },
        "status": { "enum": ["planned", "ready_for_generation", "selected", "rejected", "archived"] }
      }
    },
    "executionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerNeutral", "generatesMedia", "humanApprovalRequired"],
      "properties": {
        "providerNeutral": { "const": true },
        "generatesMedia": { "const": false },
        "humanApprovalRequired": { "const": true }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sharedFixtureLocked", "onePrimaryDeltaPerOption", "canonFixedAcrossOptions", "humanSelectionRequired", "styleNotAutoActivated", "namedStyleIsAliasOnly", "noGenerationClaim"],
      "properties": {
        "sharedFixtureLocked": { "const": true },
        "onePrimaryDeltaPerOption": { "const": true },
        "canonFixedAcrossOptions": { "const": true },
        "humanSelectionRequired": { "const": true },
        "styleNotAutoActivated": { "const": true },
        "namedStyleIsAliasOnly": { "const": true },
        "noGenerationClaim": { "const": true }
      }
    },
    "skillReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "commit", "installedBy", "usedAt"],
      "properties": {
        "repository": { "type": "string", "format": "uri", "pattern": "^https://(www\\.)?github\\.com/[^/]+/[^/]+(?:\\.git)?/?$" },
        "ref": { "type": "string", "minLength": 1, "maxLength": 240 },
        "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$" },
        "contentHash": { "$ref": "#/$defs/contentHash" },
        "installedBy": { "const": "codex-environment" },
        "environmentId": { "type": "string", "maxLength": 240 },
        "usedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
