{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-studio/schemas/style-review.schema.json",
  "title": "CineWeave Style Review",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "contractVersion", "reviewId", "stylePackageRef", "candidateObservationIds", "dimensions", "decision", "validation", "skillReceipt"],
  "properties": {
    "kind": { "const": "cineweave_codex_style_review" },
    "contractVersion": { "const": "2.0.0" },
    "reviewId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$" },
    "stylePackageRef": { "$ref": "#/$defs/contractRef" },
    "candidateObservationIds": { "type": "array", "minItems": 1, "maxItems": 24, "items": { "type": "string", "minLength": 1, "maxLength": 160, "not": { "pattern": "(?:https?:|file:|[\\\\/?#])" } } },
    "dimensions": { "type": "array", "minItems": 3, "maxItems": 24, "items": { "$ref": "#/$defs/dimension" } },
    "decision": { "$ref": "#/$defs/decision" },
    "validation": { "type": "object", "additionalProperties": false, "required": ["evidenceScoped", "identityPreserved", "rightsChecked", "temporalChecked", "noProviderClaim"], "properties": { "evidenceScoped": { "const": true }, "identityPreserved": { "const": true }, "rightsChecked": { "const": true }, "temporalChecked": { "const": true }, "noProviderClaim": { "const": true } } },
    "skillReceipt": { "$ref": "#/$defs/skillReceipt" }
  },
  "$defs": {
    "contractRef": { "type": "object", "additionalProperties": false, "required": ["id", "version", "contentHash"], "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 160 }, "version": { "type": "integer", "minimum": 1 }, "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" } } },
    "dimension": { "type": "object", "additionalProperties": false, "required": ["dimensionId", "status", "score", "evidenceObservationIds", "evidence"], "properties": { "dimensionId": { "enum": ["medium", "representation", "atom_invariants", "palette", "material", "linework", "composition", "cinematography", "character_identity", "culture_costume", "performance", "motion", "temporal", "reference_contamination", "rights"] }, "status": { "enum": ["pass", "warn", "fail", "not_applicable"] }, "score": { "type": "integer", "minimum": 0, "maximum": 10 }, "evidenceObservationIds": { "type": "array", "minItems": 1, "maxItems": 24, "items": { "type": "string", "minLength": 1, "maxLength": 160 } }, "evidence": { "type": "string", "minLength": 1, "maxLength": 1200 }, "drift": { "type": "string", "maxLength": 600 }, "smallestRepairVariable": { "type": "string", "maxLength": 240 } } },
    "decision": { "type": "object", "additionalProperties": false, "required": ["nextAction", "reason"], "properties": { "nextAction": { "enum": ["accept", "conditional", "repair", "reject", "block"] }, "reason": { "type": "string", "minLength": 1, "maxLength": 1600 }, "smallestRepairVariable": { "type": "string", "maxLength": 240 }, "stopCondition": { "type": "string", "maxLength": 600 } } },
    "skillReceipt": { "type": "object", "additionalProperties": false, "required": ["repository", "ref", "commit", "installedBy", "usedAt"], "properties": { "repository": { "type": "string", "format": "uri", "pattern": "^https://(www\\.)?github\\.com/[^/]+/[^/]+(?:\\.git)?/?$" }, "ref": { "type": "string", "minLength": 1, "maxLength": 240 }, "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$" }, "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" }, "installedBy": { "const": "codex-environment" }, "environmentId": { "type": "string", "maxLength": 240 }, "usedAt": { "type": "string", "format": "date-time" } } }
  }
}
