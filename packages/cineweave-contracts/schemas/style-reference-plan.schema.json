{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-studio/schemas/style-reference-plan.schema.json",
  "title": "CineWeave Style Reference Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "contractVersion", "planId", "status", "purpose", "stage", "references", "policy", "humanGate", "validation", "skillReceipt"],
  "properties": {
    "kind": { "const": "cineweave_codex_style_reference_plan" },
    "contractVersion": { "const": "2.0.0" },
    "worldId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "planId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$" },
    "stylePackageRef": { "$ref": "#/$defs/contractRef" },
    "status": { "enum": ["draft", "planned", "approved", "blocked", "archived"] },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 1600 },
    "stage": { "enum": ["design_time", "runtime", "validation", "mixed"] },
    "references": { "type": "array", "minItems": 1, "maxItems": 24, "items": { "$ref": "#/$defs/reference" } },
    "policy": { "$ref": "#/$defs/policy" },
    "humanGate": { "$ref": "#/$defs/humanGate" },
    "validation": { "type": "object", "additionalProperties": false, "required": ["rolesScoped", "extractIgnoreDeclared", "rightsFlagged", "noPrivateUrls", "temporalRolesSeparated"], "properties": { "rolesScoped": { "const": true }, "extractIgnoreDeclared": { "const": true }, "rightsFlagged": { "const": true }, "noPrivateUrls": { "const": true }, "temporalRolesSeparated": { "const": true } } },
    "skillReceipt": { "$ref": "#/$defs/skillReceipt" }
  },
  "$defs": {
    "contractRef": { "type": "object", "additionalProperties": false, "required": ["id", "version", "contentHash"], "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 160 }, "version": { "type": "integer", "minimum": 1 }, "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" } } },
    "stringList": { "type": "array", "minItems": 1, "maxItems": 24, "items": { "type": "string", "minLength": 1, "maxLength": 1200 } },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["referenceId", "sourceType", "role", "scope", "extract", "ignore", "preserve", "allowedTransforms", "authority", "requiredAt", "rightsStatus"],
      "properties": {
        "referenceId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$" },
        "observationId": { "type": "string", "minLength": 1, "maxLength": 160, "not": { "pattern": "(?:https?:|file:|[\\\\/?#])" } },
        "sourceType": { "enum": ["image", "video", "text", "palette", "motion_curve", "candidate_media"] },
        "sourceLabel": { "type": "string", "minLength": 1, "maxLength": 500 },
        "role": { "enum": ["character_visual", "costume", "environment", "lighting", "composition", "palette", "linework", "shading", "material", "camera_motion", "performance", "temporal_atmosphere", "validation_positive", "validation_boundary", "validation_negative"] },
        "scope": { "enum": ["style", "character", "costume", "scene", "camera", "performance", "motion", "temporal", "image", "video"] },
        "extract": { "$ref": "#/$defs/stringList" },
        "ignore": { "$ref": "#/$defs/stringList" },
        "preserve": { "$ref": "#/$defs/stringList" },
        "allowedTransforms": { "$ref": "#/$defs/stringList" },
        "authority": { "enum": ["high", "medium", "low", "unknown"] },
        "requiredAt": { "enum": ["design_time", "runtime", "validation", "conditional"] },
        "rightsStatus": { "enum": ["confirmed", "unverified", "unknown", "restricted"] },
        "licenseProfileRef": { "$ref": "#/$defs/contractRef" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "maxVisualReferences", "maxTemporalReferences", "requiredWhen", "fallback"],
      "properties": {
        "mode": { "enum": ["none", "design_time_only", "optional_runtime", "required_runtime", "adaptive"] },
        "maxVisualReferences": { "type": "integer", "minimum": 0, "maximum": 24 },
        "maxTemporalReferences": { "type": "integer", "minimum": 0, "maximum": 24 },
        "requiredWhen": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 240 } },
        "fallback": { "type": "object", "additionalProperties": false, "required": ["useSemanticSpec", "useCompilerProfile", "blockOnRightsGap"], "properties": { "useSemanticSpec": { "type": "boolean" }, "useCompilerProfile": { "type": "boolean" }, "blockOnRightsGap": { "type": "boolean" } } }
      }
    },
    "humanGate": { "type": "object", "additionalProperties": false, "required": ["requiresHumanApproval", "status"], "properties": { "requiresHumanApproval": { "const": true }, "status": { "enum": ["planned", "approved", "blocked", "rejected"] }, "approvedBy": { "type": "string", "maxLength": 240 }, "approvedAt": { "type": "string", "format": "date-time" } } },
    "skillReceipt": { "type": "object", "additionalProperties": false, "required": ["repository", "ref", "commit", "installedBy", "usedAt"], "properties": { "repository": { "type": "string", "format": "uri", "pattern": "^https://(www\\.)?github\\.com/[^/]+/[^/]+(?:\\.git)?/?$" }, "ref": { "type": "string", "minLength": 1, "maxLength": 240 }, "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$" }, "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" }, "installedBy": { "const": "codex-environment" }, "environmentId": { "type": "string", "maxLength": 240 }, "usedAt": { "type": "string", "format": "date-time" } } }
  }
}
