{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-studio/schemas/morphology-review.schema.json",
  "title": "CineWeave Morphology Review",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "contractVersion", "reviewId", "version", "morphologySpecRef", "evidenceObservationIds", "dimensions", "decision", "executionBoundary", "validation", "skillReceipt"],
  "properties": {
    "kind": { "const": "cineweave_codex_morphology_review" },
    "contractVersion": { "const": "2.5.0" },
    "reviewId": { "$ref": "#/$defs/lowerId" },
    "version": { "type": "integer", "minimum": 1 },
    "morphologySpecRef": { "$ref": "#/$defs/morphologyRef" },
    "evidenceObservationIds": {
      "type": "array",
      "minItems": 3,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/lowerId" }
    },
    "dimensions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/dimension" }
    },
    "repairRecommendation": { "$ref": "#/$defs/repairRecommendation" },
    "decision": { "$ref": "#/$defs/decision" },
    "executionBoundary": { "$ref": "#/$defs/executionBoundary" },
    "validation": { "$ref": "#/$defs/validation" },
    "skillReceipt": { "$ref": "#/$defs/skillReceipt" }
  },
  "$defs": {
    "lowerId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$" },
    "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" },
    "stringList": { "type": "array", "minItems": 1, "maxItems": 48, "items": { "type": "string", "minLength": 1, "maxLength": 1200 } },
    "morphologyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "version", "contentHash"],
      "properties": {
        "kind": { "const": "cineweave_codex_character_morphology_spec" },
        "id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "version": { "type": "integer", "minimum": 1 },
        "contentHash": { "$ref": "#/$defs/contentHash" }
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensionId", "scope", "status", "severity", "evidenceObservationIds", "finding"],
      "properties": {
        "dimensionId": { "$ref": "#/$defs/lowerId" },
        "scope": { "enum": ["view_consistency", "axis_preservation", "relation_coherence", "anatomy", "asymmetry", "expression_stability", "body_proportion", "lock_preservation"] },
        "status": { "enum": ["pass", "warn", "fail"] },
        "severity": { "enum": ["advisory", "important", "blocking"] },
        "evidenceObservationIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/lowerId" }
        },
        "finding": { "type": "string", "minLength": 1, "maxLength": 1600 },
        "affectedAxisIds": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/lowerId" }
        }
      }
    },
    "repairRecommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changeOnlyAxisId", "preserveAxisIds", "target", "acceptanceChecks"],
      "properties": {
        "changeOnlyAxisId": { "$ref": "#/$defs/lowerId" },
        "preserveAxisIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/lowerId" }
        },
        "target": { "type": "string", "minLength": 1, "maxLength": 1600 },
        "acceptanceChecks": { "$ref": "#/$defs/stringList" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overallStatus", "nextAction", "humanApprovalRequired", "identityLockApproved"],
      "properties": {
        "overallStatus": { "enum": ["pass", "warn", "fail"] },
        "nextAction": { "enum": ["lock_identity", "repair_axis", "gather_evidence", "continue_exploration", "reject"] },
        "humanApprovalRequired": { "const": true },
        "identityLockApproved": { "type": "boolean" },
        "approvalRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "contentHash"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 160 },
            "version": { "type": "integer", "minimum": 1 },
            "contentHash": { "$ref": "#/$defs/contentHash" }
          }
        },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 1600 }
      }
    },
    "executionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerNeutral", "generatesMedia", "humanApprovalRequired"],
      "properties": {
        "providerNeutral": { "const": true },
        "generatesMedia": { "const": false },
        "humanApprovalRequired": { "const": true }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["neutralEvidenceRequired", "blockingFailurePreventsLock", "oneVariableRepair", "noUniversalBeautyScore", "noBiometricInference", "noGenerationClaim"],
      "properties": {
        "neutralEvidenceRequired": { "const": true },
        "blockingFailurePreventsLock": { "const": true },
        "oneVariableRepair": { "const": true },
        "noUniversalBeautyScore": { "const": true },
        "noBiometricInference": { "const": true },
        "noGenerationClaim": { "const": true }
      }
    },
    "skillReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "commit", "installedBy", "usedAt"],
      "properties": {
        "repository": { "type": "string", "format": "uri", "pattern": "^https://(www\\.)?github\\.com/[^/]+/[^/]+(?:\\.git)?/?$" },
        "ref": { "type": "string", "minLength": 1, "maxLength": 240 },
        "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$" },
        "contentHash": { "$ref": "#/$defs/contentHash" },
        "installedBy": { "const": "codex-environment" },
        "environmentId": { "type": "string", "maxLength": 240 },
        "usedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
