{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-studio/schemas/character-exploration-brief.schema.json",
  "title": "CineWeave Character Exploration Brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "worldId",
    "explorationId",
    "status",
    "inputMode",
    "purpose",
    "experienceAxes",
    "sharedFixture",
    "locks",
    "unknowns",
    "executionBoundary",
    "validation",
    "skillReceipt"
  ],
  "properties": {
    "kind": { "const": "cineweave_codex_character_exploration_brief" },
    "contractVersion": { "const": "2.0.0" },
    "worldId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "explorationId": { "$ref": "#/$defs/lowerId" },
    "status": { "enum": ["draft", "ready", "converged", "archived"] },
    "inputMode": { "enum": ["zero_prompt", "quick", "guided", "professional"] },
    "creativeBriefRef": { "$ref": "#/$defs/contractRef" },
    "sourcePrompt": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 2400 },
    "experienceAxes": { "$ref": "#/$defs/experienceAxes" },
    "sharedFixture": { "$ref": "#/$defs/sharedFixture" },
    "referenceBindings": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/referenceBinding" }
    },
    "locks": { "$ref": "#/$defs/locks" },
    "unknowns": { "$ref": "#/$defs/unknowns" },
    "executionBoundary": { "$ref": "#/$defs/executionBoundary" },
    "validation": { "$ref": "#/$defs/validation" },
    "skillReceipt": { "$ref": "#/$defs/skillReceipt" }
  },
  "$defs": {
    "lowerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 1200 },
      "minItems": 1,
      "maxItems": 24
    },
    "optionalStringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 1200 },
      "maxItems": 24
    },
    "contractRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "contentHash"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "version": { "type": "integer", "minimum": 1 },
        "contentHash": { "$ref": "#/$defs/contentHash" }
      }
    },
    "skillReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "commit", "installedBy", "usedAt"],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(www\\.)?github\\.com/[^/]+/[^/]+(?:\\.git)?/?$"
        },
        "ref": { "type": "string", "minLength": 1, "maxLength": 240 },
        "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$" },
        "contentHash": { "$ref": "#/$defs/contentHash" },
        "installedBy": { "const": "codex-environment" },
        "environmentId": { "type": "string", "maxLength": 240 },
        "usedAt": { "type": "string", "format": "date-time" }
      }
    },
    "experienceAxes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visualWorld",
        "temperament",
        "representation",
        "ornamentDensity",
        "ageImpression",
        "firstVisualPriority",
        "primaryExplorationAxis"
      ],
      "properties": {
        "visualWorld": { "type": "string", "minLength": 1, "maxLength": 800 },
        "temperament": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["axisId", "label", "weight"],
            "properties": {
              "axisId": { "$ref": "#/$defs/lowerId" },
              "label": { "type": "string", "minLength": 1, "maxLength": 240 },
              "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
            }
          }
        },
        "representation": {
          "enum": ["live_action", "hand_drawn_2d", "digital_2d", "three_d", "comic", "illustration", "mixed"]
        },
        "ornamentDensity": { "enum": ["minimal", "refined", "ornate"] },
        "ageImpression": { "enum": ["young_adult", "adult", "mature"] },
        "firstVisualPriority": { "enum": ["gaze", "facial_structure", "styling", "costume", "movement", "atmosphere"] },
        "primaryExplorationAxis": {
          "enum": ["facial_structure", "eye_expression", "face_softness", "age_impression", "body_silhouette", "posture_energy"]
        }
      }
    },
    "sharedFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framing", "camera", "lighting", "background", "grooming", "wardrobe", "expression", "preserve"],
      "properties": {
        "framing": { "type": "string", "minLength": 1, "maxLength": 800 },
        "camera": { "type": "string", "minLength": 1, "maxLength": 800 },
        "lighting": { "type": "string", "minLength": 1, "maxLength": 800 },
        "background": { "type": "string", "minLength": 1, "maxLength": 800 },
        "grooming": { "type": "string", "minLength": 1, "maxLength": 800 },
        "wardrobe": { "type": "string", "minLength": 1, "maxLength": 800 },
        "expression": { "type": "string", "minLength": 1, "maxLength": 800 },
        "preserve": { "$ref": "#/$defs/stringList" }
      }
    },
    "referenceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["referenceId", "role", "preserve", "ignore", "rightsStatus"],
      "properties": {
        "referenceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "not": { "pattern": "(?:https?:|file:|[\\\\/?#])" }
        },
        "role": { "enum": ["identity", "appearance", "skin_material", "style", "body", "capture", "lighting", "composition"] },
        "preserve": { "$ref": "#/$defs/stringList" },
        "ignore": { "$ref": "#/$defs/stringList" },
        "rightsStatus": { "enum": ["confirmed", "unverified", "unknown", "restricted"] }
      }
    },
    "locks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hard", "soft", "free", "undefined"],
      "properties": {
        "hard": { "$ref": "#/$defs/stringList" },
        "soft": { "$ref": "#/$defs/stringList" },
        "free": { "$ref": "#/$defs/stringList" },
        "undefined": { "$ref": "#/$defs/stringList" }
      }
    },
    "unknowns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assumptions", "openQuestions", "safeDefaults"],
      "properties": {
        "assumptions": { "$ref": "#/$defs/stringList" },
        "openQuestions": { "$ref": "#/$defs/stringList" },
        "safeDefaults": { "$ref": "#/$defs/stringList" }
      }
    },
    "executionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerNeutral", "generatesMedia", "humanApprovalRequired"],
      "properties": {
        "providerNeutral": { "const": true },
        "generatesMedia": { "const": false },
        "humanApprovalRequired": { "const": true },
        "notes": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userControlsPreference", "noUniversalBeautyScore", "noBiometricInference", "styleDoesNotOwnIdentity", "noGenerationClaim"],
      "properties": {
        "userControlsPreference": { "const": true },
        "noUniversalBeautyScore": { "const": true },
        "noBiometricInference": { "const": true },
        "styleDoesNotOwnIdentity": { "const": true },
        "noGenerationClaim": { "const": true }
      }
    }
  }
}
