{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-studio/schemas/character-preference-feedback.schema.json",
  "title": "CineWeave Character Preference Feedback",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "worldId",
    "feedbackId",
    "status",
    "optionSetRef",
    "feedbackMode",
    "signals",
    "convergence",
    "policy",
    "executionBoundary",
    "validation",
    "skillReceipt"
  ],
  "properties": {
    "kind": { "const": "cineweave_codex_character_preference_feedback" },
    "contractVersion": { "const": "2.0.0" },
    "worldId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "feedbackId": { "$ref": "#/$defs/lowerId" },
    "status": { "enum": ["draft", "recorded", "applied", "archived"] },
    "optionSetRef": { "$ref": "#/$defs/contractRef" },
    "feedbackMode": { "enum": ["ranking", "pairwise", "local_preference", "mixed"] },
    "signals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": { "$ref": "#/$defs/signal" }
    },
    "convergence": { "$ref": "#/$defs/convergence" },
    "policy": { "$ref": "#/$defs/policy" },
    "executionBoundary": { "$ref": "#/$defs/executionBoundary" },
    "validation": { "$ref": "#/$defs/validation" },
    "skillReceipt": { "$ref": "#/$defs/skillReceipt" }
  },
  "$defs": {
    "lowerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 1200 },
      "minItems": 1,
      "maxItems": 24
    },
    "contractRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "contentHash"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "version": { "type": "integer", "minimum": 1 },
        "contentHash": { "$ref": "#/$defs/contentHash" }
      }
    },
    "skillReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "commit", "installedBy", "usedAt"],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(www\\.)?github\\.com/[^/]+/[^/]+(?:\\.git)?/?$"
        },
        "ref": { "type": "string", "minLength": 1, "maxLength": 240 },
        "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$" },
        "contentHash": { "$ref": "#/$defs/contentHash" },
        "installedBy": { "const": "codex-environment" },
        "environmentId": { "type": "string", "maxLength": 240 },
        "usedAt": { "type": "string", "format": "date-time" }
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signalId", "type", "optionId", "targetScope", "direction", "strength"],
      "properties": {
        "signalId": { "$ref": "#/$defs/lowerId" },
        "type": { "enum": ["select", "rank", "compare", "more_less", "avoid"] },
        "optionId": { "$ref": "#/$defs/lowerId" },
        "comparisonOptionId": { "$ref": "#/$defs/lowerId" },
        "targetScope": { "enum": ["global", "face", "eyes", "jaw", "nose", "lips", "body", "posture", "styling", "expression"] },
        "direction": { "enum": ["preserve", "more", "less", "avoid"] },
        "strength": { "type": "number", "minimum": 0, "maximum": 1 },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 1600 }
      }
    },
    "convergence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nextAction", "preserve", "requestedChanges", "identityLockRequested"],
      "properties": {
        "nextAction": { "enum": ["refine_options", "draft_character_spec", "collect_neutral_evidence", "stop"] },
        "selectedOptionIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/lowerId" }
        },
        "preserve": { "$ref": "#/$defs/stringList" },
        "requestedChanges": { "$ref": "#/$defs/stringList" },
        "identityLockRequested": { "const": false }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["persistenceScope", "userCanEditOrDelete", "universalBeautyScoreProhibited", "sensitiveInferenceProhibited", "realPersonLikenessNotInferred"],
      "properties": {
        "persistenceScope": { "enum": ["session", "project_opt_in"] },
        "userCanEditOrDelete": { "const": true },
        "universalBeautyScoreProhibited": { "const": true },
        "sensitiveInferenceProhibited": { "const": true },
        "realPersonLikenessNotInferred": { "const": true }
      }
    },
    "executionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerNeutral", "generatesMedia", "humanApprovalRequired"],
      "properties": {
        "providerNeutral": { "const": true },
        "generatesMedia": { "const": false },
        "humanApprovalRequired": { "const": true },
        "notes": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["optionSetBound", "userControlled", "noUniversalBeautyScore", "noBiometricInference", "noGenerationClaim", "identityNotAutoLocked"],
      "properties": {
        "optionSetBound": { "const": true },
        "userControlled": { "const": true },
        "noUniversalBeautyScore": { "const": true },
        "noBiometricInference": { "const": true },
        "noGenerationClaim": { "const": true },
        "identityNotAutoLocked": { "const": true }
      }
    }
  }
}
