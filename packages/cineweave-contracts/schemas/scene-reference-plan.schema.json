{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-studio/schemas/scene-reference-plan.schema.json",
  "title": "CineWeave Scene Reference Generation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "worldId",
    "planId",
    "status",
    "sceneSpecRef",
    "skillReceipt",
    "purpose",
    "phases",
    "selectionPolicy",
    "executionBoundary",
    "validation"
  ],
  "properties": {
    "kind": {
      "const": "cineweave_codex_scene_reference_plan"
    },
    "contractVersion": {
      "const": "2.0.0"
    },
    "worldId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "planId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
    },
    "status": {
      "enum": [
        "draft",
        "planned",
        "approved",
        "archived"
      ]
    },
    "sceneSpecRef": {
      "$ref": "#/$defs/sceneSpecRef"
    },
    "skillReceipt": {
      "$ref": "#/$defs/skillReceipt"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "phases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/phase"
      },
      "minItems": 1,
      "maxItems": 6
    },
    "selectionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requiresHumanApproval": {
          "const": true
        },
        "maxSelectedPerPhase": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "geographyLockAfter": {
          "enum": [
            "none",
            "geography",
            "architecture",
            "full_reference_set"
          ]
        },
        "rejectionPolicy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      },
      "required": [
        "requiresHumanApproval",
        "maxSelectedPerPhase",
        "geographyLockAfter",
        "rejectionPolicy"
      ]
    },
    "executionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "providerNeutral": {
          "const": true
        },
        "generatesMedia": {
          "const": false
        },
        "humanApprovalRequired": {
          "const": true
        }
      },
      "required": [
        "providerNeutral",
        "generatesMedia",
        "humanApprovalRequired"
      ]
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "specHashBound": {
          "const": true
        },
        "rolesScoped": {
          "const": true
        },
        "geographyFirst": {
          "const": true
        },
        "rightsChecked": {
          "const": true
        }
      },
      "required": [
        "specHashBound",
        "rolesScoped",
        "geographyFirst",
        "rightsChecked"
      ]
    },
    "assetRecipeRefs": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "contentHash"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "contentHash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-fA-F]{64}$"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  },
  "$defs": {
    "skillReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(www\\.)?github\\.com/[^/]+/[^/]+(?:\\.git)?/?$"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "installedBy": {
          "const": "codex-environment"
        },
        "environmentId": {
          "type": "string",
          "maxLength": 240
        },
        "usedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "repository",
        "ref",
        "commit",
        "installedBy",
        "usedAt"
      ]
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{1,159}$"
    },
    "lowerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
    },
    "observationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "not": {
        "pattern": "(?:https?:|file:|[\\\\/?#])"
      }
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1200
      },
      "minItems": 1,
      "maxItems": 24
    },
    "optionalStringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1200
      },
      "maxItems": 24
    },
    "characterSpecRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "characterId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        }
      },
      "required": [
        "characterId",
        "version",
        "contentHash"
      ]
    },
    "appearanceStateRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "appearanceStateId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        }
      },
      "required": [
        "appearanceStateId",
        "version",
        "contentHash"
      ]
    },
    "sceneSpecRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sceneId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        }
      },
      "required": [
        "sceneId",
        "version",
        "contentHash"
      ]
    },
    "sceneStateRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sceneStateId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        }
      },
      "required": [
        "sceneStateId",
        "version",
        "contentHash"
      ]
    },
    "executionGate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requiresHumanApproval": {
          "const": true
        },
        "status": {
          "enum": [
            "planned",
            "approved",
            "blocked",
            "rejected"
          ]
        },
        "approvedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "requiresHumanApproval",
        "status"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "user_authored",
            "codex_authored",
            "adapted",
            "imported",
            "migrated"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "parentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "changeLog": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "minItems": 1,
          "maxItems": 24
        }
      },
      "required": [
        "source",
        "createdAt",
        "updatedAt",
        "changeLog"
      ]
    },
    "frameSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frameId": {
          "$ref": "#/$defs/stableId"
        },
        "scope": {
          "enum": [
            "geography",
            "architecture",
            "scale",
            "material",
            "lighting",
            "atmosphere",
            "prop_layout",
            "camera_axis"
          ]
        },
        "view": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "cameraAnchorId": {
          "$ref": "#/$defs/stableId"
        },
        "sceneStateRef": {
          "$ref": "#/$defs/sceneStateRef"
        },
        "primaryTarget": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "preserve": {
          "$ref": "#/$defs/stringList"
        },
        "allowedChanges": {
          "$ref": "#/$defs/stringList"
        },
        "negativeConstraints": {
          "$ref": "#/$defs/stringList"
        },
        "approvalStatus": {
          "enum": [
            "planned",
            "generated",
            "selected",
            "rejected",
            "archived"
          ]
        }
      },
      "required": [
        "frameId",
        "scope",
        "view",
        "primaryTarget",
        "preserve",
        "allowedChanges",
        "negativeConstraints",
        "approvalStatus"
      ]
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phaseId": {
          "$ref": "#/$defs/stableId"
        },
        "type": {
          "enum": [
            "geography",
            "architecture",
            "material",
            "lighting",
            "atmosphere",
            "prop_layout"
          ]
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "frameSpecs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frameSpec"
          },
          "minItems": 1,
          "maxItems": 24
        }
      },
      "required": [
        "phaseId",
        "type",
        "objective",
        "frameSpecs"
      ]
    }
  }
}
