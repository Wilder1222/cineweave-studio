{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-studio/schemas/character-option-set.schema.json",
  "title": "CineWeave Character Exploration Option Set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "worldId",
    "optionSetId",
    "status",
    "explorationBriefRef",
    "sharedFixture",
    "explorationAxis",
    "options",
    "qualityGate",
    "selectionPolicy",
    "executionBoundary",
    "validation",
    "skillReceipt"
  ],
  "properties": {
    "kind": { "const": "cineweave_codex_character_option_set" },
    "contractVersion": { "const": "2.0.0" },
    "worldId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "optionSetId": { "$ref": "#/$defs/lowerId" },
    "status": { "enum": ["draft", "ready_for_generation", "reviewing", "converged", "archived"] },
    "explorationBriefRef": { "$ref": "#/$defs/contractRef" },
    "sharedFixture": { "$ref": "#/$defs/sharedFixture" },
    "explorationAxis": {
      "enum": ["facial_structure", "eye_expression", "face_softness", "age_impression", "body_silhouette", "posture_energy"]
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/option" }
    },
    "qualityGate": { "$ref": "#/$defs/qualityGate" },
    "selectionPolicy": { "$ref": "#/$defs/selectionPolicy" },
    "executionBoundary": { "$ref": "#/$defs/executionBoundary" },
    "validation": { "$ref": "#/$defs/validation" },
    "skillReceipt": { "$ref": "#/$defs/skillReceipt" }
  },
  "$defs": {
    "lowerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 1200 },
      "minItems": 1,
      "maxItems": 24
    },
    "contractRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "contentHash"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "version": { "type": "integer", "minimum": 1 },
        "contentHash": { "$ref": "#/$defs/contentHash" }
      }
    },
    "skillReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "commit", "installedBy", "usedAt"],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(www\\.)?github\\.com/[^/]+/[^/]+(?:\\.git)?/?$"
        },
        "ref": { "type": "string", "minLength": 1, "maxLength": 240 },
        "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$" },
        "contentHash": { "$ref": "#/$defs/contentHash" },
        "installedBy": { "const": "codex-environment" },
        "environmentId": { "type": "string", "maxLength": 240 },
        "usedAt": { "type": "string", "format": "date-time" }
      }
    },
    "sharedFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framing", "camera", "lighting", "background", "grooming", "wardrobe", "expression", "preserve"],
      "properties": {
        "framing": { "type": "string", "minLength": 1, "maxLength": 800 },
        "camera": { "type": "string", "minLength": 1, "maxLength": 800 },
        "lighting": { "type": "string", "minLength": 1, "maxLength": 800 },
        "background": { "type": "string", "minLength": 1, "maxLength": 800 },
        "grooming": { "type": "string", "minLength": 1, "maxLength": 800 },
        "wardrobe": { "type": "string", "minLength": 1, "maxLength": 800 },
        "expression": { "type": "string", "minLength": 1, "maxLength": 800 },
        "preserve": { "$ref": "#/$defs/stringList" }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["optionId", "displayName", "summary", "primaryDelta", "identityHypothesis", "preserve", "avoid", "promptIntent", "status"],
      "properties": {
        "optionId": { "$ref": "#/$defs/lowerId" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 240 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "primaryDelta": {
          "type": "object",
          "additionalProperties": false,
          "required": ["axis", "direction", "hypothesis"],
          "properties": {
            "axis": {
              "enum": ["facial_structure", "eye_expression", "face_softness", "age_impression", "body_silhouette", "posture_energy"]
            },
            "direction": { "type": "string", "minLength": 1, "maxLength": 800 },
            "hypothesis": { "type": "string", "minLength": 1, "maxLength": 1200 }
          }
        },
        "identityHypothesis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["faceStructure", "eyes", "bodySilhouette", "temperament"],
          "properties": {
            "faceStructure": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "eyes": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "bodySilhouette": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "temperament": { "type": "string", "minLength": 1, "maxLength": 1000 }
          }
        },
        "preserve": { "$ref": "#/$defs/stringList" },
        "avoid": { "$ref": "#/$defs/stringList" },
        "promptIntent": { "type": "string", "minLength": 1, "maxLength": 2400 },
        "status": { "enum": ["planned", "ready_for_generation", "selected", "rejected", "archived"] }
      }
    },
    "qualityGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criteria", "blocksIdentityLockOnFailure", "doesNotScoreAttractiveness"],
      "properties": {
        "criteria": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": ["anatomy", "age_alignment", "identity_clarity", "representation_fit", "artifact_risk", "reference_rights"]
          }
        },
        "blocksIdentityLockOnFailure": { "const": true },
        "doesNotScoreAttractiveness": { "const": true }
      }
    },
    "selectionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiresHumanSelection", "onePrimaryDeltaPerRound", "maxSelectedOptions", "convergenceRequiresNeutralEvidence"],
      "properties": {
        "requiresHumanSelection": { "const": true },
        "onePrimaryDeltaPerRound": { "const": true },
        "maxSelectedOptions": { "type": "integer", "minimum": 1, "maximum": 2 },
        "convergenceRequiresNeutralEvidence": { "const": true }
      }
    },
    "executionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerNeutral", "generatesMedia", "humanApprovalRequired"],
      "properties": {
        "providerNeutral": { "const": true },
        "generatesMedia": { "const": false },
        "humanApprovalRequired": { "const": true },
        "notes": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sharedFixtureLocked", "onePrimaryDeltaPerOption", "noUniversalBeautyScore", "humanSelectionRequired", "styleDoesNotOwnIdentity", "noGenerationClaim"],
      "properties": {
        "sharedFixtureLocked": { "const": true },
        "onePrimaryDeltaPerOption": { "const": true },
        "noUniversalBeautyScore": { "const": true },
        "humanSelectionRequired": { "const": true },
        "styleDoesNotOwnIdentity": { "const": true },
        "noGenerationClaim": { "const": true }
      }
    }
  }
}
