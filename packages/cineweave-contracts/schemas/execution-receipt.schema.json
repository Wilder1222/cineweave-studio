{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-studio/schemas/execution-receipt.schema.json",
  "title": "CineWeave Execution Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "receiptId",
    "runtimeVersion",
    "status",
    "executionMode",
    "requestArtifactRef",
    "adapterDescriptorRef",
    "capabilityProfileRef",
    "idempotencyKey",
    "timing",
    "authorizationEvidence",
    "attempts",
    "outputs",
    "costSummary",
    "failure",
    "validation"
  ],
  "properties": {
    "kind": { "const": "cineweave_execution_receipt" },
    "contractVersion": { "const": "2.3.0" },
    "receiptId": { "$ref": "common.schema.json#/$defs/identifier" },
    "runtimeVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "status": { "enum": ["dry_run", "succeeded", "failed", "blocked"] },
    "executionMode": { "enum": ["dry_run", "fixture", "external"] },
    "requestArtifactRef": { "$ref": "common.schema.json#/$defs/contractRef" },
    "adapterDescriptorRef": { "$ref": "common.schema.json#/$defs/contractRef" },
    "capabilityProfileRef": { "$ref": "common.schema.json#/$defs/contractRef" },
    "idempotencyKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{7,239}$" },
    "timing": { "$ref": "#/$defs/timing" },
    "authorizationEvidence": { "$ref": "#/$defs/authorizationEvidence" },
    "attempts": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/attempt" }
    },
    "outputs": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/output" }
    },
    "costSummary": { "$ref": "#/$defs/costSummary" },
    "failure": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/failure" }
      ]
    },
    "validation": { "$ref": "#/$defs/validation" }
  },
  "$defs": {
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startedAt", "finishedAt", "durationMs"],
      "properties": {
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "durationMs": { "type": "integer", "minimum": 0 }
      }
    },
    "authorizationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "decision", "approvalRecordHash", "exactRequestHashMatched"],
      "properties": {
        "required": { "type": "boolean" },
        "decision": { "enum": ["not_required", "approved", "missing", "rejected"] },
        "approvalRecordHash": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "exactRequestHashMatched": { "type": "boolean" }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt",
        "status",
        "startedAt",
        "finishedAt",
        "providerRequestId",
        "retryReason",
        "errorCode",
        "costAmount",
        "currency"
      ],
      "properties": {
        "attempt": { "type": "integer", "minimum": 1, "maximum": 8 },
        "status": { "enum": ["succeeded", "failed", "blocked"] },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "providerRequestId": { "type": ["string", "null"], "maxLength": 240 },
        "retryReason": { "type": ["string", "null"], "maxLength": 800 },
        "errorCode": { "type": ["string", "null"], "maxLength": 160 },
        "costAmount": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outputId",
        "mediaKind",
        "mimeType",
        "byteLength",
        "contentHash",
        "storageRef",
        "width",
        "height",
        "durationMs"
      ],
      "properties": {
        "outputId": { "$ref": "common.schema.json#/$defs/identifier" },
        "mediaKind": { "enum": ["image", "video"] },
        "mimeType": { "type": "string", "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$" },
        "byteLength": { "type": "integer", "minimum": 0 },
        "contentHash": { "$ref": "common.schema.json#/$defs/contentHash" },
        "storageRef": {
          "type": "string",
          "pattern": "^executions/[a-z0-9][a-z0-9._-]{1,159}/[a-zA-Z0-9._-]+$",
          "maxLength": 400
        },
        "width": { "type": ["integer", "null"], "minimum": 1 },
        "height": { "type": ["integer", "null"], "minimum": 1 },
        "durationMs": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "costSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "estimatedAmount", "actualAmount", "withinBudget", "includesAllAttempts"],
      "properties": {
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "estimatedAmount": { "type": ["number", "null"], "minimum": 0 },
        "actualAmount": { "type": "number", "minimum": 0 },
        "withinBudget": { "type": "boolean" },
        "includesAllAttempts": { "const": true }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "code", "retryable", "message"],
      "properties": {
        "stage": { "enum": ["preflight", "authorization", "adapter", "output_verification", "receipt_persistence"] },
        "code": { "$ref": "common.schema.json#/$defs/identifier" },
        "retryable": { "type": "boolean" },
        "message": { "type": "string", "minLength": 1, "maxLength": 1200 }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapterMatched",
        "requestHashMatched",
        "inputsMatched",
        "outputHashesVerified",
        "secretsAbsent",
        "externalSideEffectAuthorized"
      ],
      "properties": {
        "adapterMatched": { "type": "boolean" },
        "requestHashMatched": { "type": "boolean" },
        "inputsMatched": { "type": "boolean" },
        "outputHashesVerified": { "type": "boolean" },
        "secretsAbsent": { "type": "boolean" },
        "externalSideEffectAuthorized": { "type": "boolean" }
      }
    }
  }
}
