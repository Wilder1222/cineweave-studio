{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-studio/schemas/style-exploration-brief.schema.json",
  "title": "CineWeave Style Exploration Brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "contractVersion", "worldId", "explorationId", "status", "inputMode", "purpose", "desiredExperience", "primaryExplorationAxis", "sharedFixture", "referenceBindings", "selectionPolicy", "executionBoundary", "validation", "skillReceipt"],
  "properties": {
    "kind": { "const": "cineweave_codex_style_exploration_brief" },
    "contractVersion": { "const": "2.5.0" },
    "worldId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "explorationId": { "$ref": "#/$defs/lowerId" },
    "status": { "enum": ["draft", "ready", "converged", "archived"] },
    "inputMode": { "enum": ["zero_prompt", "quick", "guided", "professional"] },
    "creativeBriefRef": { "$ref": "#/$defs/exactRef" },
    "sourcePrompt": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 2400 },
    "desiredExperience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mediumCandidates", "impressions", "audienceEffect", "avoid"],
      "properties": {
        "mediumCandidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "enum": ["live_action", "hand_drawn_2d", "digital_2d", "comic", "illustration", "three_d", "mixed", "unknown"] }
        },
        "impressions": { "$ref": "#/$defs/stringList" },
        "audienceEffect": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "avoid": { "$ref": "#/$defs/stringList" }
      }
    },
    "primaryExplorationAxis": { "$ref": "#/$defs/styleAxis" },
    "sharedFixture": { "$ref": "#/$defs/sharedFixture" },
    "referenceBindings": {
      "type": "array",
      "maxItems": 24,
      "items": { "$ref": "#/$defs/referenceBinding" }
    },
    "selectionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiresHumanSelection", "onePrimaryAxisPerRound", "maxSelectedOptions", "fixedCanonRequired"],
      "properties": {
        "requiresHumanSelection": { "const": true },
        "onePrimaryAxisPerRound": { "const": true },
        "maxSelectedOptions": { "type": "integer", "minimum": 1, "maximum": 2 },
        "fixedCanonRequired": { "const": true }
      }
    },
    "executionBoundary": { "$ref": "#/$defs/executionBoundary" },
    "validation": { "$ref": "#/$defs/validation" },
    "skillReceipt": { "$ref": "#/$defs/skillReceipt" }
  },
  "$defs": {
    "lowerId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$" },
    "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" },
    "stringList": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 1200 } },
    "styleAxis": { "enum": ["representation", "geometry", "shape_language", "linework", "surface", "shading", "color", "lighting", "depth", "composition", "performance", "motion", "effects", "postprocess"] },
    "exactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "version", "contentHash"],
      "properties": {
        "kind": { "type": "string", "minLength": 1, "maxLength": 160 },
        "id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "version": { "type": "integer", "minimum": 1 },
        "contentHash": { "$ref": "#/$defs/contentHash" }
      }
    },
    "sharedFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["characterRef", "appearanceRef", "sceneRef", "shotDescription", "action", "camera", "lightingSourceState", "fixedAcrossOptions"],
      "properties": {
        "characterRef": { "$ref": "#/$defs/exactRef" },
        "appearanceRef": { "$ref": "#/$defs/exactRef" },
        "sceneRef": { "$ref": "#/$defs/exactRef" },
        "shotDescription": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "action": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "camera": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "lightingSourceState": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "fixedAcrossOptions": { "const": true }
      }
    },
    "referenceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observationRef", "scope", "transfer", "ignore"],
      "properties": {
        "observationRef": { "$ref": "#/$defs/exactRef" },
        "scope": { "enum": ["representation_geometry", "shape_language", "linework", "surface_style", "shading", "color_system", "lighting_representation", "depth_language", "composition", "motion_style", "effects", "panel_layout", "typography", "postprocess"] },
        "transfer": { "$ref": "#/$defs/stringList" },
        "ignore": { "$ref": "#/$defs/stringList" }
      }
    },
    "executionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerNeutral", "generatesMedia", "humanApprovalRequired"],
      "properties": {
        "providerNeutral": { "const": true },
        "generatesMedia": { "const": false },
        "humanApprovalRequired": { "const": true }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonFixedAcrossOptions", "onePrimaryAxisPerRound", "userControlsPreference", "namedStyleIsAliasOnly", "staticReferenceDoesNotProveMotion", "styleDoesNotOwnIdentity", "noGenerationClaim"],
      "properties": {
        "canonFixedAcrossOptions": { "const": true },
        "onePrimaryAxisPerRound": { "const": true },
        "userControlsPreference": { "const": true },
        "namedStyleIsAliasOnly": { "const": true },
        "staticReferenceDoesNotProveMotion": { "const": true },
        "styleDoesNotOwnIdentity": { "const": true },
        "noGenerationClaim": { "const": true }
      }
    },
    "skillReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "commit", "installedBy", "usedAt"],
      "properties": {
        "repository": { "type": "string", "format": "uri", "pattern": "^https://(www\\.)?github\\.com/[^/]+/[^/]+(?:\\.git)?/?$" },
        "ref": { "type": "string", "minLength": 1, "maxLength": 240 },
        "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$" },
        "contentHash": { "$ref": "#/$defs/contentHash" },
        "installedBy": { "const": "codex-environment" },
        "environmentId": { "type": "string", "maxLength": 240 },
        "usedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
