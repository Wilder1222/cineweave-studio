{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-studio/schemas/approval-record.schema.json",
  "title": "CineWeave Human Approval Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "contractVersion", "approvalId", "artifactRef", "decision", "actor", "decidedAt", "rationale", "approvalHash"],
  "properties": {
    "kind": { "const": "cineweave_approval_record" },
    "contractVersion": { "enum": ["2.2.0", "2.3.0"] },
    "approvalId": { "$ref": "common.schema.json#/$defs/identifier" },
    "artifactRef": { "$ref": "common.schema.json#/$defs/contractRef" },
    "decision": { "enum": ["approved", "rejected"] },
    "actor": { "type": "string", "minLength": 1, "maxLength": 240 },
    "decidedAt": { "type": "string", "format": "date-time" },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "approvalHash": { "$ref": "common.schema.json#/$defs/contentHash" }
  }
}
