{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-studio/schemas/style-preference-feedback.schema.json",
  "title": "CineWeave Style Preference Feedback",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "contractVersion", "feedbackId", "version", "optionSetRef", "signals", "convergence", "policy", "executionBoundary", "validation", "skillReceipt"],
  "properties": {
    "kind": { "const": "cineweave_codex_style_preference_feedback" },
    "contractVersion": { "const": "2.5.0" },
    "feedbackId": { "$ref": "#/$defs/lowerId" },
    "version": { "type": "integer", "minimum": 1 },
    "optionSetRef": { "$ref": "#/$defs/optionSetRef" },
    "signals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": { "$ref": "#/$defs/signal" }
    },
    "convergence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectedOptionIds", "nextAction", "styleActivationRequested", "nextExplorationAxis"],
      "properties": {
        "selectedOptionIds": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/lowerId" }
        },
        "nextAction": { "enum": ["continue_exploration", "draft_style_package", "stop"] },
        "styleActivationRequested": { "const": false },
        "nextExplorationAxis": { "$ref": "#/$defs/styleAxis" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userCanEditOrDelete", "namedStyleIsAliasOnly", "noUniversalQualityScore", "noCreatorImitationClaim", "styleNotAutoActivated"],
      "properties": {
        "userCanEditOrDelete": { "const": true },
        "namedStyleIsAliasOnly": { "const": true },
        "noUniversalQualityScore": { "const": true },
        "noCreatorImitationClaim": { "const": true },
        "styleNotAutoActivated": { "const": true }
      }
    },
    "executionBoundary": { "$ref": "#/$defs/executionBoundary" },
    "validation": { "$ref": "#/$defs/validation" },
    "skillReceipt": { "$ref": "#/$defs/skillReceipt" }
  },
  "$defs": {
    "lowerId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$" },
    "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" },
    "styleAxis": { "enum": ["representation", "geometry", "shape_language", "linework", "surface", "shading", "color", "lighting", "depth", "composition", "performance", "motion", "effects", "postprocess"] },
    "optionSetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "version", "contentHash"],
      "properties": {
        "kind": { "const": "cineweave_codex_style_option_set" },
        "id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "version": { "type": "integer", "minimum": 1 },
        "contentHash": { "$ref": "#/$defs/contentHash" }
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signalId", "optionId", "type", "scope", "statement"],
      "properties": {
        "signalId": { "$ref": "#/$defs/lowerId" },
        "optionId": { "$ref": "#/$defs/lowerId" },
        "type": { "enum": ["prefer", "reject", "keep", "reduce", "increase", "compare"] },
        "comparisonOptionId": { "$ref": "#/$defs/lowerId" },
        "scope": { "$ref": "#/$defs/styleAxis" },
        "statement": { "type": "string", "minLength": 1, "maxLength": 1200 }
      }
    },
    "executionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerNeutral", "generatesMedia", "humanApprovalRequired"],
      "properties": {
        "providerNeutral": { "const": true },
        "generatesMedia": { "const": false },
        "humanApprovalRequired": { "const": true }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["optionSetBound", "oneAxisFeedback", "userPreferenceRetained", "styleNotAutoActivated", "noGenerationClaim"],
      "properties": {
        "optionSetBound": { "const": true },
        "oneAxisFeedback": { "const": true },
        "userPreferenceRetained": { "const": true },
        "styleNotAutoActivated": { "const": true },
        "noGenerationClaim": { "const": true }
      }
    },
    "skillReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "commit", "installedBy", "usedAt"],
      "properties": {
        "repository": { "type": "string", "format": "uri", "pattern": "^https://(www\\.)?github\\.com/[^/]+/[^/]+(?:\\.git)?/?$" },
        "ref": { "type": "string", "minLength": 1, "maxLength": 240 },
        "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$" },
        "contentHash": { "$ref": "#/$defs/contentHash" },
        "installedBy": { "const": "codex-environment" },
        "environmentId": { "type": "string", "maxLength": 240 },
        "usedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
