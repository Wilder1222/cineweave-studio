{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-studio/schemas/hypothesis-output.schema.json",
  "title": "CineWeave Codex Prompt Hypothesis Payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "contractVersion", "worldId", "skillReceipt", "hypotheses"],
  "properties": {
    "kind": { "const": "cineweave_codex_prompt_hypothesis" },
    "contractVersion": { "const": "2.0.0" },
    "worldId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "sourceInput": { "type": "string", "maxLength": 1200 },
    "skillReceipt": { "$ref": "#/$defs/skillReceipt" },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/hypothesis" }
    }
  },
  "$defs": {
    "skillReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "commit", "installedBy", "usedAt"],
      "properties": {
        "repository": { "type": "string", "format": "uri", "pattern": "^https://(www\\.)?github\\.com/[^/]+/[^/]+/?$" },
        "ref": { "type": "string", "minLength": 1, "maxLength": 240 },
        "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$" },
        "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" },
        "installedBy": { "const": "codex-environment" },
        "environmentId": { "type": "string", "maxLength": 240 },
        "usedAt": { "type": "string", "format": "date-time" }
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fragment", "category", "confidence", "unknowns", "observationIds"],
      "properties": {
        "hypothesisId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "fragment": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "category": { "enum": ["subject", "identity", "state", "environment", "composition", "camera", "light", "color", "material", "style", "atmosphere", "negative"] },
        "confidence": { "enum": ["high", "medium", "low", "unknown"] },
        "unknowns": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
        "observationIds": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
        "analysisRunId": { "type": "string", "minLength": 1, "maxLength": 240 },
        "modelSnapshot": { "type": "string", "minLength": 1, "maxLength": 240 },
        "inputHash": { "type": "string", "minLength": 1, "maxLength": 240 },
        "alternativeHypotheses": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 1000 } }
      }
    }
  }
}
