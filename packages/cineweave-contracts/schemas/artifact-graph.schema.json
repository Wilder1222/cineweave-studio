{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-studio/schemas/artifact-graph.schema.json",
  "title": "CineWeave Exact Artifact Dependency Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "contractVersion", "generatedAt", "project", "scope", "nodes", "edges", "cycles", "gate", "summary"],
  "properties": {
    "kind": { "const": "cineweave_artifact_graph" },
    "contractVersion": { "const": "2.4.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "projectManifestHash", "runtimeVersion"],
      "properties": {
        "projectId": { "$ref": "common.schema.json#/$defs/identifier" },
        "projectManifestHash": { "$ref": "common.schema.json#/$defs/contentHash" },
        "runtimeVersion": { "enum": ["2.2.0", "2.3.0", "2.3.1", "2.4.0"] }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "rootArtifactRef", "direction"],
      "properties": {
        "mode": { "enum": ["project", "artifact_closure"] },
        "rootArtifactRef": {
          "anyOf": [
            { "$ref": "common.schema.json#/$defs/contractRef" },
            { "type": "null" }
          ]
        },
        "direction": { "enum": ["dependencies", "dependents", "both"] }
      }
    },
    "nodes": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "maxItems": 500000,
      "items": { "$ref": "#/$defs/edge" }
    },
    "cycles": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/cycle" }
    },
    "gate": {
      "anyOf": [
        { "$ref": "#/$defs/gate" },
        { "type": "null" }
      ]
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "approvalId", "decision", "actor", "decidedAt", "approvalHash"],
      "properties": {
        "state": { "enum": ["unreviewed", "approved", "rejected"] },
        "approvalId": { "type": ["string", "null"], "maxLength": 160 },
        "decision": { "type": ["string", "null"], "enum": ["approved", "rejected", null] },
        "actor": { "type": ["string", "null"], "maxLength": 240 },
        "decidedAt": { "type": ["string", "null"], "format": "date-time" },
        "approvalHash": {
          "anyOf": [
            { "$ref": "common.schema.json#/$defs/contentHash" },
            { "type": "null" }
          ]
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "artifactRef", "artifactStatus", "createdAt", "createdBy", "latestVersion", "versionState", "approval", "inboundReferenceCount", "outboundReferenceCount"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,159}/[a-z0-9][a-z0-9._-]{1,159}@[1-9][0-9]*:sha256:[0-9a-f]{64}$" },
        "artifactRef": { "$ref": "common.schema.json#/$defs/contractRef" },
        "artifactStatus": { "enum": ["draft", "candidate", "approved", "rejected", "archived", "dry_run", "succeeded", "failed", "blocked"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 240 },
        "latestVersion": { "type": "integer", "minimum": 1 },
        "versionState": { "enum": ["current", "superseded"] },
        "approval": { "$ref": "#/$defs/approval" },
        "inboundReferenceCount": { "type": "integer", "minimum": 0 },
        "outboundReferenceCount": { "type": "integer", "minimum": 0 }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceArtifactRef", "targetArtifactRef", "jsonPointer", "status", "targetVersionState", "latestAvailableVersion"],
      "properties": {
        "sourceArtifactRef": { "$ref": "common.schema.json#/$defs/contractRef" },
        "targetArtifactRef": { "$ref": "common.schema.json#/$defs/contractRef" },
        "jsonPointer": { "type": "string", "maxLength": 1600 },
        "status": { "enum": ["resolved", "missing", "hash_mismatch"] },
        "targetVersionState": { "enum": ["current", "superseded", "unresolved"] },
        "latestAvailableVersion": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "cycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cycleId", "artifactRefs", "edgeCount"],
      "properties": {
        "cycleId": { "type": "string", "pattern": "^cycle\\.[0-9]{3,}$" },
        "artifactRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/contractRef" }
        },
        "edgeCount": { "type": "integer", "minimum": 1 }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactRef", "policy", "approvalState", "allowed", "blockingReasons", "warnings", "missingDependencyCount", "hashMismatchDependencyCount", "supersededDependencyRefCount", "unapprovedDependencyCount", "cycleCount"],
      "properties": {
        "artifactRef": { "$ref": "common.schema.json#/$defs/contractRef" },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requireCurrent", "requireDependencyApprovals"],
          "properties": {
            "requireCurrent": { "type": "boolean" },
            "requireDependencyApprovals": { "type": "boolean" }
          }
        },
        "approvalState": { "enum": ["unreviewed", "approved", "rejected"] },
        "allowed": { "type": "boolean" },
        "blockingReasons": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["artifact_rejected", "artifact_unapproved", "missing_dependencies", "hash_mismatched_dependencies", "dependency_cycle", "unapproved_dependencies", "artifact_superseded", "superseded_dependency_refs"] }
        },
        "warnings": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["artifact_superseded", "superseded_dependency_refs"] }
        },
        "missingDependencyCount": { "type": "integer", "minimum": 0 },
        "hashMismatchDependencyCount": { "type": "integer", "minimum": 0 },
        "supersededDependencyRefCount": { "type": "integer", "minimum": 0 },
        "unapprovedDependencyCount": { "type": "integer", "minimum": 0 },
        "cycleCount": { "type": "integer", "minimum": 0 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactCount", "referenceCount", "resolvedReferenceCount", "missingReferenceCount", "hashMismatchReferenceCount", "supersededArtifactCount", "supersededReferenceCount", "rootCount", "leafCount", "cycleCount", "approvalCounts"],
      "properties": {
        "artifactCount": { "type": "integer", "minimum": 0 },
        "referenceCount": { "type": "integer", "minimum": 0 },
        "resolvedReferenceCount": { "type": "integer", "minimum": 0 },
        "missingReferenceCount": { "type": "integer", "minimum": 0 },
        "hashMismatchReferenceCount": { "type": "integer", "minimum": 0 },
        "supersededArtifactCount": { "type": "integer", "minimum": 0 },
        "supersededReferenceCount": { "type": "integer", "minimum": 0 },
        "rootCount": { "type": "integer", "minimum": 0 },
        "leafCount": { "type": "integer", "minimum": 0 },
        "cycleCount": { "type": "integer", "minimum": 0 },
        "approvalCounts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unreviewed", "approved", "rejected"],
          "properties": {
            "unreviewed": { "type": "integer", "minimum": 0 },
            "approved": { "type": "integer", "minimum": 0 },
            "rejected": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
