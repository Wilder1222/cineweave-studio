{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-studio/schemas/adapter-descriptor.schema.json",
  "title": "CineWeave Adapter Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "adapterId",
    "adapterVersion",
    "protocolVersion",
    "displayName",
    "status",
    "adapterClass",
    "skillReceipt",
    "implementation",
    "capabilityProfileRef",
    "licenseProfileRefs",
    "semanticEmphasis",
    "executionModes",
    "operations",
    "security",
    "costPolicy",
    "validation",
    "provenance"
  ],
  "properties": {
    "kind": { "const": "cineweave_adapter_descriptor" },
    "contractVersion": { "const": "2.3.0" },
    "adapterId": { "$ref": "common.schema.json#/$defs/identifier" },
    "adapterVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "protocolVersion": { "const": "1.0.0" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 160 },
    "status": { "enum": ["draft", "active", "deprecated", "retired"] },
    "adapterClass": {
      "enum": [
        "image_generation",
        "image_editing",
        "video_generation",
        "composite",
        "fixture"
      ]
    },
    "skillReceipt": { "$ref": "common.schema.json#/$defs/skillReceipt" },
    "implementation": { "$ref": "#/$defs/implementation" },
    "capabilityProfileRef": { "$ref": "common.schema.json#/$defs/contractRef" },
    "licenseProfileRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/contractRef" }
    },
    "semanticEmphasis": { "$ref": "#/$defs/semanticEmphasis" },
    "executionModes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["dry_run", "fixture", "external"] }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": { "$ref": "#/$defs/operation" }
    },
    "security": { "$ref": "#/$defs/security" },
    "costPolicy": { "$ref": "#/$defs/costPolicy" },
    "validation": { "$ref": "#/$defs/validation" },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
  },
  "$defs": {
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distribution", "entrypointId", "contentHash"],
      "properties": {
        "distribution": { "enum": ["core_fixture", "plugin_extension", "external_service_bridge"] },
        "entrypointId": { "$ref": "common.schema.json#/$defs/identifier" },
        "contentHash": { "$ref": "common.schema.json#/$defs/contentHash" }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "mediaKinds",
        "requestModes",
        "requiredCapabilityIds",
        "acceptedInputRoles",
        "outputMimeTypes",
        "maxInputs",
        "maxOutputs",
        "supportsIdempotency",
        "parameterSchemaId"
      ],
      "properties": {
        "operationId": { "$ref": "common.schema.json#/$defs/identifier" },
        "mediaKinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["image", "video"] }
        },
        "requestModes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["generate", "edit", "inpaint", "multi_reference"] }
        },
        "requiredCapabilityIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/identifier" }
        },
        "acceptedInputRoles": {
          "type": "array",
          "maxItems": 24,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/identifier" }
        },
        "outputMimeTypes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$" }
        },
        "maxInputs": { "type": "integer", "minimum": 0, "maximum": 64 },
        "maxOutputs": { "type": "integer", "minimum": 1, "maximum": 64 },
        "supportsIdempotency": { "type": "boolean" },
        "parameterSchemaId": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9][a-z0-9._-]{1,159}$"
        }
      }
    },
    "semanticEmphasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptedLevels", "translationMode", "providerSpecificSyntaxStored"],
      "properties": {
        "acceptedLevels": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["required", "strong", "supporting"] }
        },
        "translationMode": { "enum": ["unsupported", "ordering_only", "adapter_native"] },
        "providerSpecificSyntaxStored": { "const": false }
      },
      "allOf": [
        {
          "if": { "properties": { "translationMode": { "const": "unsupported" } } },
          "then": { "properties": { "acceptedLevels": { "maxItems": 0 } } },
          "else": { "properties": { "acceptedLevels": { "minItems": 1 } } }
        }
      ]
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "networkAccess",
        "networkPolicyId",
        "credentialEnvVars",
        "contractsMayContainSecrets",
        "externalEffectsDefaultDenied",
        "arbitraryCommandExecution",
        "outputRootConstrained"
      ],
      "properties": {
        "networkAccess": { "enum": ["forbidden", "external_mode_only"] },
        "networkPolicyId": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9][a-z0-9._-]{1,159}$"
        },
        "credentialEnvVars": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,79}$" }
        },
        "contractsMayContainSecrets": { "const": false },
        "externalEffectsDefaultDenied": { "const": true },
        "arbitraryCommandExecution": { "const": false },
        "outputRootConstrained": { "const": true }
      }
    },
    "costPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "estimateSupport", "unknownCostAction", "retryCostAccounting"],
      "properties": {
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "estimateSupport": { "enum": ["none", "bounded", "exact"] },
        "unknownCostAction": { "const": "block" },
        "retryCostAccounting": { "const": "include_all_attempts" }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationIdsUnique",
        "capabilityProfileExact",
        "licenseProfilesExact",
        "implementationHashVerified",
        "noEndpointOrCredentialValues"
      ],
      "properties": {
        "operationIdsUnique": { "const": true },
        "capabilityProfileExact": { "const": true },
        "licenseProfilesExact": { "const": true },
        "implementationHashVerified": { "const": true },
        "noEndpointOrCredentialValues": { "const": true }
      }
    }
  }
}
