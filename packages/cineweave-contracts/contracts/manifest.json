      "consumes": ["NaturalLanguageBrief", "CreativeBrief", "ReferenceReview", "ReferenceSet", "CharacterSpec", "SceneSpec", "CharacterBinding", "SceneBinding", "ObservationIds"],
      "standalone": true,
      "composable": true
