      "consumes": ["NaturalLanguageBrief", "CreativeBrief", "CharacterExplorationBrief", "CharacterOptionSet", "CharacterPreferenceFeedback", "WorldContext", "ObservationIds", "StyleCompile", "ProductionContracts"],
      "standalone": true,
      "composable": true
    },
    {
      "name": "cineweave-scene",
