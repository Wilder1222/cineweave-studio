      "consumes": ["NaturalLanguageBrief", "CreativeBrief", "CharacterBinding", "SceneBinding", "InteractionConstraintSet", "StyleCompile", "ProductionContracts"],
      "standalone": true,
      "composable": true
    },
    {
      "name": "cineweave-production",
      "role": "production_validation",
      "owns": ["asset_recipe", "control_plan", "evidence_bundle", "capability_profile", "license_profile", "control_benchmark"],
