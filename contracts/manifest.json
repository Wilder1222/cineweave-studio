  "recipeCatalog": {
    "path": "recipes/catalog.json",
    "schema": "schemas/asset-recipe.schema.json",
    "builtInRecipeCount": 7
  },
  "compatibility": {
    "reads": [
      "0.5.x",
      "0.6.x",
      "1.0.x",
      "1.1.0"
    ],
    "writes": "1.1.0",
    "oldBindingsRemainValid": true,
    "newProductionFieldsOptional": true,
    "newInteractionFieldsOptional": true,
    "lockedAssetsNeverOverwritten": true
  },
  "boundaries": {
    "providerNeutral": true,
    "humanApprovalForExecution": true,
    "noCanonMutationBySkills": true,
    "noInventedObservationIds": true,
    "noPrivatePathsOrSignedUrls": true,
    "noAssumedCommercialRights": true,
    "capabilityMismatchBlocksHardControls": true
  }
}
