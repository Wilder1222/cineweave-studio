{
  "name": "cineweave-studio",
  "version": "2.3.1",
  "private": true,
  "type": "module",
  "description": "Composable creative Skills, contracts and deterministic local runtime for CineWeave Studio.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/runtime/*.test.mjs",
    "validate": "node scripts/run-release-checks.mjs",
    "runtime": "node packages/cineweave-runtime/bin/cineweave.mjs",
    "board": "node packages/cineweave-runtime/bin/assemble-board.mjs",
    "evals": "node scripts/run-behavior-evals.mjs --validate",
    "evals:live": "node scripts/run-live-skill-evals.mjs"
  },
  "bin": {
    "cineweave-studio": "./packages/cineweave-runtime/bin/cineweave.mjs"
  },
  "license": "MIT"
}
