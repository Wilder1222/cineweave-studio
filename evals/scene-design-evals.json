{
  "suite": "cineweave-scene-design",
  "version": "1.0.0",
  "purpose": "Behavior contract for geography-first SceneSpec design, SceneState, SceneBinding, reference planning, consistency review and one-variable repair.",
  "cases": [
    {
      "id": "scene-three-immutable-anchors",
      "mode": "scene_design",
      "prompt": "设计一条悬于云海的东方宫殿长廊，用于追逐和保护场面。",
      "loads": [
        "scene-design",
        "scene-spatial-continuity"
      ],
      "expectedOutput": "scene-spec",
      "assertions": [
        "at least three immutable anchors",
        "zones and traversable connections",
        "entrances and exits are oriented",
        "scale anchors are explicit",
        "status remains draft"
      ]
    },
    {
      "id": "scene-geography-before-style",
      "mode": "scene_design",
      "prompt": "先确定宫门、屏风、断桥和行动轴线，再讨论仙侠风格。",
      "loads": [
        "scene-design"
      ],
      "expectedOutput": "scene-spec",
      "assertions": [
        "geography precedes visual decoration",
        "landmarks have zones",
        "camera axes are explicit",
        "style does not replace topology"
      ]
    },
    {
      "id": "scene-controlled-weather-state",
      "mode": "scene_state",
      "prompt": "同一长廊进入暴雨前黄昏状态，但地理和屏风位置不变。",
      "loads": [
        "scene-state"
      ],
      "expectedOutput": "scene-state",
      "assertions": [
        "only declared variables are assigned",
        "geography is preserved",
        "light source and direction are physical",
        "wind response is directional"
      ]
    },
    {
      "id": "scene-shot-binding",
      "mode": "scene_binding",
      "prompt": "把角色放在第三开间屏风后，机位保持主轴B侧。",
      "loads": [
        "scene-binding",
        "scene-spatial-continuity"
      ],
      "expectedOutput": "scene-binding",
      "assertions": [
        "exact SceneSpec hash",
        "active zones and anchors",
        "camera anchor axis and side",
        "depth layers and material response",
        "forbidden axis crossing"
      ]
    },
    {
      "id": "scene-reference-geography-first",
      "mode": "scene_reference_plan",
      "prompt": "规划场景参考图：主轴、反向、俯视、材质、黄昏和暴雨状态。",
      "loads": [
        "scene-reference-planning"
      ],
      "expectedOutput": "scene-reference-plan",
      "assertions": [
        "geography phase precedes materials and lighting",
        "each frame has one scope",
        "human selection required",
        "plan does not claim generation"
      ]
    },
    {
      "id": "scene-review-blocking-drift",
      "mode": "scene_review",
      "prompt": "候选图把第三开间屏风移动到了另一侧，但光线很好。",
      "loads": [
        "scene-consistency",
        "scene-review-repair"
      ],
      "expectedOutput": "scene-review",
      "assertions": [
        "geography failure is blocking",
        "aesthetic quality does not override topology",
        "Observation evidence is cited",
        "decision is not accept"
      ]
    },
    {
      "id": "scene-one-variable-repair",
      "mode": "scene_repair",
      "prompt": "只把屏风恢复到第三开间西北侧，其他全部保持。",
      "loads": [
        "scene-review-repair"
      ],
      "expectedOutput": "scene-repair",
      "assertions": [
        "one target path",
        "passing camera character light and material evidence is preserved",
        "human approval gate",
        "no success claim"
      ]
    },
    {
      "id": "negative-floating-architecture",
      "mode": "near_miss",
      "prompt": "柱子可以随便悬浮，只要画面宏大。",
      "loads": [
        "scene-design"
      ],
      "expectedOutput": "structured correction",
      "assertions": [
        "requires construction support",
        "does not use epic as spatial logic",
        "labels World exceptions if supplied"
      ]
    },
    {
      "id": "negative-weather-mutates-geography",
      "mode": "near_miss",
      "prompt": "下雨后宫门自动换到断桥端。",
      "loads": [
        "scene-state"
      ],
      "expectedOutput": "boundary or new SceneSpec version requirement",
      "assertions": [
        "SceneState cannot move geography",
        "requires Canon event and new SceneSpec version"
      ]
    },
    {
      "id": "negative-invented-scene-hash",
      "mode": "scene_binding",
      "prompt": "没有 SceneSpec，但随便补一个 hash 继续。",
      "loads": [
        "scene-binding"
      ],
      "expectedOutput": "missing-context statement",
      "assertions": [
        "does not invent content hash",
        "does not emit a valid binding"
      ]
    }
  ]
}
