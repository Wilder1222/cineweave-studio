{
  "suite": "cineweave-cross-skill-v1",
  "version": "1.0.0",
  "purpose": "End-to-end contract for routing and assembling Character, Scene and Director outputs without domain overwrite.",
  "cases": [
    {
      "id": "route-character-owner",
      "mode": "routing",
      "prompt": "创建人物脸、身材比例和动作指纹。",
      "loads": [
        "cineweave-character"
      ],
      "expectedOutput": "character-spec",
      "assertions": [
        "Director does not duplicate CharacterSpec",
        "Character Skill owns identity"
      ]
    },
    {
      "id": "route-scene-owner",
      "mode": "routing",
      "prompt": "创建宫殿长廊的地理、材质和灯光状态。",
      "loads": [
        "cineweave-scene"
      ],
      "expectedOutput": "scene-spec or scene-state",
      "assertions": [
        "Director does not duplicate SceneSpec",
        "Scene Skill owns geography"
      ]
    },
    {
      "id": "route-director-owner",
      "mode": "routing",
      "prompt": "用已有 CharacterBinding 和 SceneBinding 设计三镜头追逐。",
      "loads": [
        "cineweave-director"
      ],
      "expectedOutput": "storyboard-output",
      "assertions": [
        "bindings are consumed not rewritten",
        "Director owns coverage and camera"
      ]
    },
    {
      "id": "integrated-image-prompt",
      "mode": "image_prompt",
      "prompt": "把受威胁角色绑定和暴雨玉廊绑定编译为一张关键帧。",
      "loads": [
        "orchestration",
        "text-to-image",
        "cinematography"
      ],
      "expectedOutput": "image-prompt-output",
      "assertions": [
        "exact character and scene refs",
        "separate prompt blocks by domain",
        "zone placement and dominant side agree",
        "cross-skill receipts checked"
      ]
    },
    {
      "id": "integrated-storyboard-continuity",
      "mode": "storyboard",
      "prompt": "同一人物沿同一长廊停步、遮挡、保护孩子。",
      "loads": [
        "orchestration",
        "storyboarding"
      ],
      "expectedOutput": "storyboard-output",
      "assertions": [
        "character action end/start continuity",
        "SceneState and geography anchors continue",
        "camera axis and screen direction are explicit",
        "appearance and material states remain stable"
      ]
    },
    {
      "id": "conflict-character-zone",
      "mode": "assembly_conflict",
      "prompt": "CharacterBinding 指向不存在的 SceneBinding zone。",
      "loads": [
        "orchestration"
      ],
      "expectedOutput": "blocked assembly",
      "assertions": [
        "does not invent zone",
        "requests corrected owning binding",
        "does not silently change CharacterSpec or SceneSpec"
      ]
    },
    {
      "id": "conflict-dominant-side-prop",
      "mode": "assembly_conflict",
      "prompt": "人物右手惯用，但场景道具只允许左手位置。",
      "loads": [
        "orchestration"
      ],
      "expectedOutput": "explicit conflict resolution",
      "assertions": [
        "locked identity has precedence",
        "blocking or scene staging changes are proposed",
        "no silent dominant-side flip"
      ]
    },
    {
      "id": "mixed-repair-routing",
      "mode": "repair",
      "prompt": "脸漂移、屏风位置错误、镜头也跨轴。",
      "loads": [
        "orchestration"
      ],
      "expectedOutput": "three ordered repair payloads",
      "assertions": [
        "character repair routed to Character",
        "scene repair routed to Scene",
        "camera repair remains Director",
        "one variable per payload",
        "execution order is explicit"
      ]
    },
    {
      "id": "migration-v06",
      "mode": "migration",
      "prompt": "把 v0.6 CharacterSpec 转为 v1。",
      "loads": [
        "migration"
      ],
      "expectedOutput": "copy plus migration-report",
      "assertions": [
        "source file is not overwritten",
        "facts and rights preserved",
        "contractVersion added",
        "locked asset warning",
        "target schema checked"
      ]
    },
    {
      "id": "negative-provider-execution",
      "mode": "near_miss",
      "prompt": "直接调用付费模型并把结果锁成 Canon。",
      "loads": [
        "execution-adapter"
      ],
      "expectedOutput": "boundary refusal or human-gated plan",
      "assertions": [
        "no Provider call",
        "no Canon mutation",
        "no invented task receipt"
      ]
    }
  ]
}
