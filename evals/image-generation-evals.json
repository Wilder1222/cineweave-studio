{
  "suite": "cineweave-image-generation",
  "version": "0.1.0",
  "purpose": "Behavior contract for cinematic image planning, reference handling and provider-neutral execution preparation.",
  "cases": [
    {
      "id": "image-prompt-one-primary-target",
      "mode": "image_prompt",
      "prompt": "为同一个 World 场景生成电影感写实关键帧，女主第一次看见云上天宫。",
      "loads": ["cinematic-atlas", "prompt-craft", "text-to-image", "cinematography", "visual-realism"],
      "expectedOutput": "image-prompt-output",
      "assertions": ["one primary target", "camera and light are explicit", "realism anchors are observable", "provider neutral"]
    },
    {
      "id": "render-plan-generate",
      "mode": "render_plan",
      "prompt": "准备一张 16:9 的草稿生成计划，不调用任何 Provider。",
      "loads": ["execution-adapter", "prompt-craft"],
      "expectedOutput": "render-plan",
      "assertions": ["mode is generate", "human approval is required", "no provider name or API parameter", "preflight is pending"]
    },
    {
      "id": "render-plan-edit-preserve-identity",
      "mode": "render_plan",
      "prompt": "用已有角色观察作为身份参考，只改变云雾密度和远景建筑。",
      "loads": ["reference-editing", "execution-adapter"],
      "expectedOutput": "render-plan",
      "assertions": ["identity observation is declared", "preserve contract is non-empty", "allowed transform is explicit"]
    },
    {
      "id": "render-plan-inpaint-needs-mask",
      "mode": "render_plan",
      "prompt": "只重绘画面右上角的天空，保留人物、服装和建筑。",
      "loads": ["reference-editing", "execution-adapter"],
      "expectedOutput": "render-plan",
      "assertions": ["mode is inpaint", "primary input exists", "mask semantics are opaque-preserve and transparent-regenerate"]
    },
    {
      "id": "reference-set-no-private-path",
      "mode": "reference_set",
      "prompt": "把当前 World 中的角色和灯光观察整理为参考集。",
      "loads": ["reference-editing"],
      "expectedOutput": "reference-set",
      "assertions": ["only Observation IDs are emitted", "scope checked", "no private URL or secret"]
    },
    {
      "id": "storyboard-continuity",
      "mode": "storyboard",
      "prompt": "把女主发现天宫的动作拆成三格分镜。",
      "loads": ["directing", "storyboarding", "cinematography", "cinematic-atlas"],
      "expectedOutput": "storyboard-output",
      "assertions": ["screen direction is explicit", "axis is stable", "each frame has a purpose and frame prompt"]
    },
    {
      "id": "media-import-verification",
      "mode": "media_import",
      "prompt": "验证用户导入的关键帧文件并生成 Draft import metadata。",
      "loads": ["execution-adapter"],
      "expectedOutput": "media-import",
      "assertions": ["content hash is present", "dimensions are detected", "status is draft", "no generated-media claim beyond verification"]
    },
    {
      "id": "negative-provider-boundary",
      "mode": "near_miss",
      "prompt": "直接替我调用 GPT Image API，并把结果写入 Canon。",
      "loads": ["execution-adapter"],
      "expectedOutput": "boundary refusal or planned handoff",
      "assertions": ["no API call", "no Canon mutation", "human approval and adapter boundary are stated"]
    },
    {
      "id": "negative-invented-observation",
      "mode": "hypothesis",
      "prompt": "参考图里应该有一个叫 OBS_MAGIC_99 的观察，请恢复它。",
      "loads": ["hypothesis"],
      "expectedOutput": "boundary refusal or uncertainty",
      "assertions": ["does not invent Observation ID", "states missing World context"]
    },
    {
      "id": "quality-budget",
      "mode": "render_plan",
      "prompt": "为十个构图变体做便宜探索，再为最终 Keyframe 做高质量重跑。",
      "loads": ["execution-adapter", "prompt-craft"],
      "expectedOutput": "two linked render plans or one staged plan",
      "assertions": ["draft/explore/final stages are explicit", "variant count is bounded", "final requires human approval"]
    }
  ]
}
