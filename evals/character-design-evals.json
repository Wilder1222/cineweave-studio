{
  "suite": "cineweave-character-design",
  "version": "1.0.0",
  "purpose": "v1 behavior contract for CharacterSpec, reference planning, appearance states, shot bindings, evidence-based review, single-variable repair and Director handoff.",
  "cases": [
    {
      "id": "character-three-identity-anchors",
      "mode": "character_design",
      "prompt": "设计一名中式幻想女巡察使，外表克制但会本能保护弱者。",
      "loads": [
        "character-design",
        "character-performance"
      ],
      "expectedOutput": "character-spec",
      "assertions": [
        "at least three immutable anchors",
        "face and body geometry are explicit",
        "identity is not only hair or wardrobe",
        "status remains draft"
      ]
    },
    {
      "id": "character-identity-appearance-separation",
      "mode": "character_design",
      "prompt": "为同一角色设计常服、朝服和战斗服，但脸和身体比例不能改变。",
      "loads": [
        "character-design"
      ],
      "expectedOutput": "character-spec",
      "assertions": [
        "identityCore is locked separately",
        "wardrobe is a controlled variable",
        "forbidden changes include face and body drift"
      ]
    },
    {
      "id": "character-observable-emotion",
      "mode": "character_performance",
      "prompt": "她很害怕但不想让追兵看出来。",
      "loads": [
        "character-performance",
        "directing"
      ],
      "expectedOutput": "character-binding",
      "assertions": [
        "emotion intensity is bounded",
        "concealment is bounded",
        "posture gaze face hands and breath are observable",
        "action arc has start trigger peak and end"
      ]
    },
    {
      "id": "character-shot-scale-filtering",
      "mode": "image_prompt",
      "prompt": "角色在超远景中穿过云上长桥。",
      "loads": [
        "character-performance",
        "text-to-image"
      ],
      "expectedOutput": "image-prompt-output",
      "assertions": [
        "wide shot uses silhouette and direction",
        "invisible pore or eyelid detail is omitted",
        "character binding preserves version and hash"
      ]
    },
    {
      "id": "character-cross-shot-continuity",
      "mode": "storyboard",
      "prompt": "把角色停步、回头、保护孩子拆成三个镜头。",
      "loads": [
        "character-performance",
        "storyboarding",
        "directing"
      ],
      "expectedOutput": "storyboard-output",
      "assertions": [
        "same CharacterSpec version and hash",
        "dominant side is stable",
        "emotion trend and action handoff are explicit",
        "each shot selects visible anchors"
      ]
    },
    {
      "id": "character-reference-scope",
      "mode": "reference_set",
      "prompt": "第一张锁脸，第二张只参考身材，第三张只参考受威胁姿势。",
      "loads": [
        "reference-editing"
      ],
      "expectedOutput": "reference-set",
      "assertions": [
        "roles and scopes are explicit",
        "pose cannot overwrite face or body",
        "only Observation IDs are emitted"
      ]
    },
    {
      "id": "character-one-variable-repair",
      "mode": "character_repair",
      "prompt": "候选图的脸正确，但右手惯用侧翻转了。",
      "loads": [
        "character-consistency"
      ],
      "expectedOutput": "character-repair",
      "assertions": [
        "dominant-side flip is identified",
        "passing face and body evidence is preserved",
        "one repair variable",
        "acceptance check and stop condition"
      ]
    },
    {
      "id": "negative-costume-as-identity",
      "mode": "near_miss",
      "prompt": "这个角色的唯一特征就是白发红衣和长剑。",
      "loads": [
        "character-design"
      ],
      "expectedOutput": "character-spec clarification or structured completion",
      "assertions": [
        "does not accept costume as complete identity",
        "adds face body and motion anchors",
        "labels assumptions"
      ]
    },
    {
      "id": "negative-style-overwrites-identity",
      "mode": "near_miss",
      "prompt": "用风格参考图覆盖当前角色，让她完全变成参考图里的人。",
      "loads": [
        "reference-editing",
        "character-consistency"
      ],
      "expectedOutput": "boundary or scoped reference plan",
      "assertions": [
        "style cannot replace identity",
        "likeness and rights are not invented",
        "preserve contract remains explicit"
      ]
    },
    {
      "id": "negative-invented-character-hash",
      "mode": "character_performance",
      "prompt": "没有 CharacterSpec 内容，但请随便补一个 hash 继续。",
      "loads": [
        "character-performance"
      ],
      "expectedOutput": "missing-context statement",
      "assertions": [
        "does not invent content hash",
        "does not emit a valid binding without exact CharacterSpec reference"
      ]
    }
  ]
}
