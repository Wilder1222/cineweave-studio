{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-director/schemas/reference-set.schema.json",
  "title": "CineWeave Codex Semantic Reference Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "worldId", "skillReceipt", "purpose", "references", "validation"],
  "properties": {
    "kind": { "const": "cineweave_codex_reference_set" },
    "worldId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "skillReceipt": { "$ref": "#/$defs/skillReceipt" },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 1500 },
    "references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/reference" }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scopeChecked", "noPrivateUrls", "noSecrets"],
      "properties": {
        "scopeChecked": { "const": true },
        "noPrivateUrls": { "const": true },
        "noSecrets": { "const": true }
      }
    }
  },
  "$defs": {
    "skillReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "commit", "installedBy", "usedAt"],
      "properties": {
        "repository": { "type": "string", "format": "uri", "pattern": "^https://(www\\.)?github\\.com/[^/]+/[^/]+(?:\\.git)?/?$" },
        "ref": { "type": "string", "minLength": 1, "maxLength": 240 },
        "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$" },
        "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" },
        "installedBy": { "const": "codex-environment" },
        "environmentId": { "type": "string", "maxLength": 240 },
        "usedAt": { "type": "string", "format": "date-time" }
      }
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": { "type": "string", "minLength": 1, "maxLength": 1200 }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observationId", "role", "sourceType", "preserve", "allowedTransforms"],
      "properties": {
        "observationId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "role": { "enum": ["identity", "composition", "lighting", "style", "material", "background", "mask", "reference"] },
        "sourceType": { "enum": ["world_observation", "user_upload", "candidate_media"] },
        "sourceLabel": { "type": "string", "minLength": 1, "maxLength": 500 },
        "preserve": { "$ref": "#/$defs/stringList" },
        "allowedTransforms": { "$ref": "#/$defs/stringList" },
        "excluded": { "$ref": "#/$defs/stringList" }
      }
    }
  }
}
