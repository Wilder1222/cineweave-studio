{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-director/schemas/draft-brief.schema.json",
  "title": "CineWeave Codex Interactive Draft Brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "worldId", "shotPurpose", "primaryFocus", "composition", "camera", "visualTreatment", "preserve", "allowedChanges", "negativeConstraints", "importContract"],
  "properties": {
    "kind": { "const": "cineweave_codex_interactive_draft_brief" },
    "worldId": { "type": "string", "minLength": 1 },
    "shotId": { "type": "string", "minLength": 1 },
    "shotPurpose": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "primaryFocus": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "composition": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "camera": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "visualTreatment": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "preserve": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "allowedChanges": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "negativeConstraints": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "importContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "statusOnCreation", "requiredMedia", "nextAction"],
      "properties": {
        "source": { "const": "codex_interactive" },
        "statusOnCreation": { "const": "draft" },
        "requiredMedia": { "type": "string", "minLength": 1 },
        "nextAction": { "type": "string", "minLength": 1 }
      }
    }
  }
}
