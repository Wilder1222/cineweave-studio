{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-director/schemas/scene-repair.schema.json",
  "title": "CineWeave Scene Single-variable Repair Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "worldId",
    "repairId",
    "sceneSpecRef",
    "parentCandidateObservationId",
    "skillReceipt",
    "failure",
    "preserve",
    "change",
    "forbiddenChanges",
    "acceptanceChecks",
    "stopCondition",
    "executionGate",
    "validation"
  ],
  "properties": {
    "kind": {
      "const": "cineweave_codex_scene_repair"
    },
    "contractVersion": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "worldId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "repairId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
    },
    "sceneSpecRef": {
      "$ref": "#/$defs/sceneSpecRef"
    },
    "parentCandidateObservationId": {
      "$ref": "#/$defs/observationId"
    },
    "reviewRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "skillReceipt": {
      "$ref": "#/$defs/skillReceipt"
    },
    "failure": {
      "$ref": "#/$defs/failure"
    },
    "preserve": {
      "$ref": "#/$defs/stringList"
    },
    "change": {
      "$ref": "#/$defs/singleChange"
    },
    "forbiddenChanges": {
      "$ref": "#/$defs/stringList"
    },
    "acceptanceChecks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/acceptanceCheck"
      },
      "minItems": 1,
      "maxItems": 12
    },
    "stopCondition": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "executionGate": {
      "$ref": "#/$defs/executionGate"
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "singleVariable": {
          "const": true
        },
        "parentImmutable": {
          "const": true
        },
        "providerNeutral": {
          "const": true
        },
        "noSuccessClaim": {
          "const": true
        }
      },
      "required": [
        "singleVariable",
        "parentImmutable",
        "providerNeutral",
        "noSuccessClaim"
      ]
    }
  },
  "$defs": {
    "skillReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(www\\.)?github\\.com/[^/]+/[^/]+(?:\\.git)?/?$"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "installedBy": {
          "const": "codex-environment"
        },
        "environmentId": {
          "type": "string",
          "maxLength": 240
        },
        "usedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "repository",
        "ref",
        "commit",
        "installedBy",
        "usedAt"
      ]
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{1,159}$"
    },
    "lowerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
    },
    "observationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "not": {
        "pattern": "(?:https?:|file:|[\\\\/?#])"
      }
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1200
      },
      "minItems": 1,
      "maxItems": 24
    },
    "optionalStringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1200
      },
      "maxItems": 24
    },
    "characterSpecRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "characterId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        }
      },
      "required": [
        "characterId",
        "version",
        "contentHash"
      ]
    },
    "appearanceStateRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "appearanceStateId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        }
      },
      "required": [
        "appearanceStateId",
        "version",
        "contentHash"
      ]
    },
    "sceneSpecRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sceneId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        }
      },
      "required": [
        "sceneId",
        "version",
        "contentHash"
      ]
    },
    "sceneStateRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sceneStateId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        }
      },
      "required": [
        "sceneStateId",
        "version",
        "contentHash"
      ]
    },
    "executionGate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requiresHumanApproval": {
          "const": true
        },
        "status": {
          "enum": [
            "planned",
            "approved",
            "blocked",
            "rejected"
          ]
        },
        "approvedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "requiresHumanApproval",
        "status"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "user_authored",
            "codex_authored",
            "adapted",
            "imported",
            "migrated"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "parentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "changeLog": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "minItems": 1,
          "maxItems": 24
        }
      },
      "required": [
        "source",
        "createdAt",
        "updatedAt",
        "changeLog"
      ]
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "geography",
            "architecture",
            "scale",
            "material",
            "prop_layout",
            "lighting",
            "atmosphere",
            "camera_axis",
            "continuity",
            "reference_rights"
          ]
        },
        "observedFailure": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1600
        },
        "evidenceObservationIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observationId"
          },
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        }
      },
      "required": [
        "category",
        "observedFailure",
        "evidenceObservationIds",
        "confidence"
      ]
    },
    "singleChange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targetPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "currentState": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "targetState": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      },
      "required": [
        "targetPath",
        "currentState",
        "targetState",
        "rationale"
      ]
    },
    "acceptanceCheck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checkId": {
          "$ref": "#/$defs/stableId"
        },
        "criterion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "expectedEvidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "status": {
          "enum": [
            "pending",
            "pass",
            "fail"
          ]
        }
      },
      "required": [
        "checkId",
        "criterion",
        "expectedEvidence",
        "status"
      ]
    }
  }
}
