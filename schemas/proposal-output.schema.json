{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-director/schemas/proposal-output.schema.json",
  "title": "CineWeave Codex Director Proposal Payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["skillReceipt", "proposals"],
  "properties": {
    "skillReceipt": { "$ref": "#/$defs/skillReceipt" },
    "sourceInput": { "type": "string", "maxLength": 1200 },
    "proposals": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/proposal" }
    }
  },
  "$defs": {
    "skillReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "commit", "installedBy", "usedAt"],
      "properties": {
        "repository": { "type": "string", "format": "uri", "pattern": "^https://(www\\.)?github\\.com/[^/]+/[^/]+/?$" },
        "ref": { "type": "string", "minLength": 1, "maxLength": 240 },
        "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$" },
        "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" },
        "installedBy": { "const": "codex-environment" },
        "environmentId": { "type": "string", "maxLength": 240 },
        "usedAt": { "type": "string", "format": "date-time" }
      }
    },
    "styleWeight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "weight"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 240 },
        "weight": { "type": "number", "minimum": 0 }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "summary", "narrativeIntent", "audienceFeeling", "composition", "camera", "performance", "visualTreatment", "soundEdit", "styleStack", "preserve", "allowedChanges", "cost", "risk", "recommendedProvider"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "narrativeIntent": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "audienceFeeling": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "composition": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "camera": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "performance": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "visualTreatment": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "soundEdit": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "styleStack": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/styleWeight" } },
        "preserve": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "allowedChanges": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "cost": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "risk": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "recommendedProvider": { "enum": ["codex", "libtv"] }
      }
    }
  }
}
