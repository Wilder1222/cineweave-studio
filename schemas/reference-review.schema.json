{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-director/schemas/reference-review.schema.json",
  "title": "CineWeave Codex Reference Suitability Review",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "skillReceipt", "purpose", "source", "decision", "primaryRole", "scores", "evidence", "referenceContract", "pairingRecommendations", "validation"],
  "properties": {
    "kind": { "const": "cineweave_codex_reference_review" },
    "worldId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "skillReceipt": { "$ref": "#/$defs/skillReceipt" },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 1500 },
    "source": { "$ref": "#/$defs/source" },
    "decision": { "enum": ["recommended", "conditional", "not_recommended"] },
    "primaryRole": { "enum": ["identity", "composition", "lighting", "style", "material", "background", "mask", "reference"] },
    "recommendedCategories": { "$ref": "#/$defs/stringList" },
    "scores": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/score" }
    },
    "evidence": { "$ref": "#/$defs/stringList" },
    "referenceContract": { "$ref": "#/$defs/referenceContract" },
    "pairingRecommendations": { "$ref": "#/$defs/stringList" },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observableEvidence", "roleScoped", "rightsFlagged", "noPrivateUrls"],
      "properties": {
        "observableEvidence": { "const": true },
        "roleScoped": { "const": true },
        "rightsFlagged": { "const": true },
        "noPrivateUrls": { "const": true }
      }
    }
  },
  "$defs": {
    "skillReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "commit", "installedBy", "usedAt"],
      "properties": {
        "repository": { "type": "string", "format": "uri", "pattern": "^https://(www\\.)?github\\.com/[^/]+/[^/]+(?:\\.git)?/?$" },
        "ref": { "type": "string", "minLength": 1, "maxLength": 240 },
        "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$" },
        "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" },
        "installedBy": { "const": "codex-environment" },
        "environmentId": { "type": "string", "maxLength": 240 },
        "usedAt": { "type": "string", "format": "date-time" }
      }
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": { "type": "string", "minLength": 1, "maxLength": 1200 }
    },
    "contractList": {
      "type": "array",
      "maxItems": 24,
      "items": { "type": "string", "minLength": 1, "maxLength": 1200 }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceType", "sourceLabel", "rightsStatus", "usageNote"],
      "properties": {
        "sourceType": { "enum": ["user_upload", "bundled_atlas", "world_observation", "candidate_media", "external_reference"] },
        "sourceLabel": { "type": "string", "minLength": 1, "maxLength": 500 },
        "sourceId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^:/?#\\\\]+$" },
        "rightsStatus": { "enum": ["confirmed", "unverified", "unknown", "restricted"] },
        "usageNote": { "type": "string", "minLength": 1, "maxLength": 1200 }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "score", "confidence", "evidence"],
      "properties": {
        "dimension": { "enum": ["identity", "composition", "lighting", "camera", "palette", "material", "pose", "environment", "typography", "editability"] },
        "score": { "type": "integer", "minimum": 0, "maximum": 10 },
        "confidence": { "enum": ["high", "medium", "low"] },
        "evidence": { "type": "string", "minLength": 1, "maxLength": 800 }
      }
    },
    "referenceContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preserve", "borrow", "exclude"],
      "properties": {
        "preserve": { "$ref": "#/$defs/contractList" },
        "borrow": { "$ref": "#/$defs/contractList" },
        "exclude": { "$ref": "#/$defs/contractList" }
      }
    }
  }
}
