{
  "suite": "cineweave-cross-skill-v1",
  "version": "1.0.0",
  "purpose": "End-to-end contract for routing and assembling Character, Scene and Director outputs without domain overwrite.",
  "cases": [
    {
      "id": "route-character-owner",
      "mode": "routing",
      "prompt": "创建人物脸、身材比例和动作指纹。",
      "loads": [
        "cineweave-character"
      ],
      "expectedOutput": "character-spec",
      "assertions": [
        "Director does not duplicate CharacterSpec",
        "Character Skill owns identity"
      ]
    },
    {
      "id": "route-scene-owner",
      "mode": "routing",
      "prompt": "创建宫殿长廊的地理、材质和灯光状态。",
      "loads": [
        "cineweave-scene"
      ],
      "expectedOutput": "scene-spec or scene-state",
      "assertions": [
        "Director does not duplicate SceneSpec",
        "Scene Skill owns geography"
      ]
    },
    {
      "id": "route-director-owner",
      "mode": "routing",
      "prompt": "用已有 CharacterBinding 和 SceneBinding 设计三镜头追逐。",
      "loads": [
        "cineweave-director"
      ],
      "expectedOutput": "storyboard-output",
      "assertions": [
        "bindings are consumed not rewritten",
        "Director owns coverage and camera"
      ]
    },
    {
      "id": "route-action-sequence-owner",
      "mode": "action_sequence",
      "prompt": "用精确 ScriptScene、CharacterBindings、PerformanceTimelines、SceneBinding 和 InteractionConstraintSets 设计茶楼保护与临河撤离；先给动作节拍、覆盖和连续性，不要先选镜头焦段。",
      "loads": [
        "action-direction",
        "orchestration"
      ],
      "expectedOutput": "action-sequence-spec",
      "assertions": [
        "Story causality is consumed not rewritten",
        "Character motion and timing are consumed not rewritten",
        "Scene zones and contacts are consumed not invented",
        "every action beat links to coverage and continuity",
        "hazardous methods remain flagged for qualified review",
        "lens and exact camera curves are deferred to ShotSpec and TemporalSpec"
      ]
    },
    {
      "id": "integrated-image-prompt",
      "mode": "image_prompt",
      "prompt": "把受威胁角色绑定和暴雨玉廊绑定编译为一张关键帧。",
      "loads": [
        "orchestration",
        "cineweave-director",
        "cineweave-prompt"
      ],
      "expectedOutput": "image-prompt-output",
      "assertions": [
        "exact character and scene refs",
        "separate prompt blocks by domain",
        "zone placement and dominant side agree",
        "cross-skill receipts checked"
      ]
    },
    {
      "id": "staged-character-reference-to-shot",
      "mode": "orchestration",
      "prompt": "从一张东方幻想角色参考图开始，评审它的身份和妆造角色，先生成定妆照和全身锚点，再做三视图与九宫格表情，最后绑定到一个正面宋韵镜头。",
      "loads": [
        "portrait-reference-craft",
        "character-visual-development",
        "orchestration"
      ],
      "expectedOutput": "named staged payloads and gated handoff",
      "assertions": [
        "reference review separates identity, appearance and capture evidence",
        "Character owns identity and appearance state",
        "Production owns two deterministic sheet recipes",
        "Director owns camera and ShotSpec",
        "Prompt owns final ImagePrompt compilation",
        "hero portrait is not silently used as sole identity proof",
        "exact bindings and human gates are present"
      ]
    },
    {
      "id": "brief-style-character-scene-handoff",
      "mode": "brief_compile",
      "prompt": "用户只说：创建一个宋韵女性角色，之后还要做黑白漫画和真人视频版本。请先整理成可编辑简报，并说明参考图、风格包、人物身份和场景分别由谁负责。",
      "loads": [
        "brief-compiler",
        "cineweave-style",
        "orchestration"
      ],
      "expectedOutput": "CreativeBrief with staged named handoffs",
      "assertions": [
        "quick/guided/professional input mode is explicit",
        "high-impact questions are limited and prioritized",
        "style atoms/package are separate from CharacterSpec",
        "visual and temporal references are separated",
        "Character, Style, Scene, Director and Production ownership is explicit"
      ]
    },
    {
      "id": "integrated-storyboard-continuity",
      "mode": "storyboard",
      "prompt": "同一人物沿同一长廊停步、遮挡、保护孩子。",
      "loads": [
        "orchestration",
        "storyboarding"
      ],
      "expectedOutput": "storyboard-output",
      "assertions": [
        "character action end/start continuity",
        "SceneState and geography anchors continue",
        "camera axis and screen direction are explicit",
        "appearance and material states remain stable"
      ]
    },
    {
      "id": "conflict-character-zone",
      "mode": "assembly_conflict",
      "prompt": "CharacterBinding 指向不存在的 SceneBinding zone。",
      "loads": [
        "orchestration"
      ],
      "expectedOutput": "blocked assembly",
      "assertions": [
        "does not invent zone",
        "requests corrected owning binding",
        "does not silently change CharacterSpec or SceneSpec"
      ]
    },
    {
      "id": "conflict-dominant-side-prop",
      "mode": "assembly_conflict",
      "prompt": "人物右手惯用，但场景道具只允许左手位置。",
      "loads": [
        "orchestration"
      ],
      "expectedOutput": "explicit conflict resolution",
      "assertions": [
        "locked identity has precedence",
        "blocking or scene staging changes are proposed",
        "no silent dominant-side flip"
      ]
    },
    {
      "id": "mixed-repair-routing",
      "mode": "repair",
      "prompt": "脸漂移、屏风位置错误、镜头也跨轴。",
      "loads": [
        "orchestration"
      ],
      "expectedOutput": "three ordered repair payloads",
      "assertions": [
        "character repair routed to Character",
        "scene repair routed to Scene",
        "camera repair remains Director",
        "one variable per payload",
        "execution order is explicit"
      ]
    },
    {
      "id": "migration-v06",
      "mode": "migration",
      "prompt": "把 v0.6 CharacterSpec 转为 v1。",
      "loads": [
        "migration"
      ],
      "expectedOutput": "copy plus migration-report",
      "assertions": [
        "source file is not overwritten",
        "facts and rights preserved",
        "contractVersion added",
        "locked asset warning",
        "target schema checked"
      ]
    },
    {
      "id": "negative-provider-execution",
      "mode": "near_miss",
      "prompt": "直接调用付费模型并把结果锁成 Canon。",
      "loads": [
        "execution-adapter"
      ],
      "expectedOutput": "boundary refusal or human-gated plan",
      "assertions": [
        "no Provider call",
        "no Canon mutation",
        "no invented task receipt"
      ]
    }
  ]
}
