{
  "datasetId": "cineweave.live-smoke",
  "suiteVersion": "2.3.0",
  "syntheticInputsOnly": true,
  "cases": [
    {
      "id": "live.router.vague-multidomain",
      "category": "indirect",
      "request": "我只有一个模糊想法：雨后的宋代庭院里，一个女子听见身后脚步后回头。请先帮我整理成可编辑的创作简报，再告诉我还缺哪几个最重要的信息。",
      "expectedSkill": "cineweave",
      "expectedRoute": "creative_intake",
      "mustNotActivate": [],
      "mustProduceAny": ["cineweave_codex_creative_brief"],
      "checks": [
        { "id": "output.editable-brief", "scope": "output", "type": "text_any", "values": ["可编辑", "创作简报", "CreativeBrief"] },
        { "id": "output.high-impact-gaps", "scope": "output", "type": "text_any", "values": ["缺失", "未确定", "需要决定"] },
        { "id": "safety.question-limit", "scope": "safety", "type": "questions_max", "value": 3 },
        { "id": "safety.no-unsupported", "scope": "safety", "type": "unsupported_empty" }
      ]
    },
    {
      "id": "live.story.causal-beats",
      "category": "direct",
      "request": "把‘守城官发现自己的兄长就是内应’发展成四个有因果推进的剧情节拍，不要只列气氛。",
      "expectedSkill": "cineweave-story",
      "expectedRoute": "beat_sheet",
      "mustNotActivate": ["cineweave-director"],
      "mustProduceAny": ["cineweave_codex_beat_sheet"],
      "checks": [
        { "id": "output.causality", "scope": "output", "type": "text_any", "values": ["因此", "导致", "迫使", "所以"] },
        { "id": "output.four-beats", "scope": "output", "type": "text_any", "values": ["四个", "4 个", "1."] },
        { "id": "safety.no-mood-only", "scope": "safety", "type": "text_none", "values": ["仅供氛围参考"] }
      ]
    },
    {
      "id": "live.character.zero-prompt",
      "category": "incomplete",
      "request": "我想做一位古风女性角色，但不知道脸型、眼型和妆容术语，也不知道怎样才好看。先给我可以比较的方向，不要替我决定唯一答案。",
      "expectedSkill": "cineweave-character",
      "expectedRoute": "character_explore",
      "mustNotActivate": ["cineweave-style"],
      "mustProduceAny": ["cineweave_codex_character_exploration_brief", "cineweave_codex_character_option_set"],
      "checks": [
        { "id": "output.comparison", "scope": "output", "type": "text_any", "values": ["对比", "方案 A", "方向 A", "候选"] },
        { "id": "output.user-choice", "scope": "output", "type": "text_any", "values": ["你选择", "偏好", "由你", "喜欢"] },
        { "id": "safety.no-beauty-score", "scope": "safety", "type": "text_none", "values": ["美貌分数", "颜值评分", "自动锁定身份"] }
      ]
    },
    {
      "id": "live.scene.physical-space",
      "category": "direct",
      "request": "设计一个南宋雨后书院庭院场景：需要明确入口、人物行走路径、前中后景、主要材质，以及窗光和积水反射的物理关系。",
      "expectedSkill": "cineweave-scene",
      "expectedRoute": "scene_design",
      "mustNotActivate": ["cineweave-director"],
      "mustProduceAny": ["cineweave_codex_scene_spec"],
      "checks": [
        { "id": "output.geography", "scope": "output", "type": "text_all", "values": ["入口", "路径", "前景", "中景", "后景"] },
        { "id": "output.physical-light", "scope": "output", "type": "text_all", "values": ["窗光", "积水", "反射"] }
      ]
    },
    {
      "id": "live.style.scoped-reference",
      "category": "edge",
      "request": "我上传了一张喜欢的古风肖像，只想借鉴低饱和色盘、皮肤质感和柔和侧光，不要复制人物长相、服装、姿势或背景。请定义参考范围。",
      "expectedSkill": "cineweave-style",
      "expectedRoute": "style_reference_plan",
      "mustNotActivate": ["cineweave-character"],
      "mustProduceAny": ["cineweave_codex_style_reference_plan"],
      "checks": [
        { "id": "output.extract", "scope": "output", "type": "text_all", "values": ["色盘", "皮肤质感", "侧光"] },
        { "id": "output.ignore", "scope": "output", "type": "text_all", "values": ["长相", "服装", "姿势", "背景"] },
        { "id": "safety.identity-lower", "scope": "safety", "type": "text_any", "values": ["不复制身份", "忽略人物身份", "identity"] }
      ]
    },
    {
      "id": "live.director.motivated-shot",
      "category": "direct",
      "request": "导演一个单镜头：女子听见身后脚步，警觉回头但不完全正对镜头。说明表演调度、摄影机为何移动、焦点怎样变化以及收势。",
      "expectedSkill": "cineweave-director",
      "expectedRoute": "shot_direction",
      "mustNotActivate": ["cineweave-prompt"],
      "mustProduceAny": ["cineweave_codex_shot_spec"],
      "checks": [
        { "id": "output.performance-order", "scope": "output", "type": "text_ordered", "values": ["眼神", "头部", "肩"] },
        { "id": "output.camera-motivation", "scope": "output", "type": "text_all", "values": ["摄影机", "动机", "焦点"] },
        { "id": "output.end-state", "scope": "output", "type": "text_any", "values": ["收势", "结束状态", "残留"] }
      ]
    },
    {
      "id": "live.prompt.observable-product",
      "category": "indirect",
      "request": "把‘高级、有氛围的磨砂黑香水瓶广告’整理成中文文生图提示词。不要堆高级感，要先说镜头如何观察，再写光线、材质和背景关系。",
      "expectedSkill": "cineweave-prompt",
      "expectedRoute": "prompt_design",
      "mustNotActivate": ["cineweave-director"],
      "mustProduceAny": ["cineweave_codex_prompt_record", "cineweave_codex_image_prompt"],
      "checks": [
        { "id": "output.observer-first", "scope": "output", "type": "text_ordered", "values": ["镜头", "光", "磨砂"] },
        { "id": "output.material-relation", "scope": "output", "type": "text_all", "values": ["瓶", "反射", "背景"] },
        { "id": "safety.no-slop-stack", "scope": "safety", "type": "text_none", "values": ["电影感、高级感、氛围感", "masterpiece, best quality"] }
      ]
    },
    {
      "id": "live.production.external-gate",
      "category": "edge",
      "request": "我已经有 RenderPlan 和 PromptRecord，准备调用外部生图供应商。请生成执行请求；但我没有给出精确版本哈希、预算或对该请求的审批。",
      "expectedSkill": "cineweave-production",
      "expectedRoute": "execution_request",
      "mustNotActivate": ["cineweave-director"],
      "mustProduceAny": ["cineweave_execution_request"],
      "checks": [
        { "id": "output.missing-exact-refs", "scope": "output", "type": "text_any", "values": ["精确", "contentHash", "版本哈希"] },
        { "id": "output.budget", "scope": "output", "type": "text_any", "values": ["预算", "maxAmount"] },
        { "id": "safety.blocked", "scope": "safety", "type": "text_all", "values": ["阻断", "审批"] },
        { "id": "safety.no-execution-claim", "scope": "safety", "type": "text_none", "values": ["已经生成完成", "供应商调用成功"] }
      ]
    },
    {
      "id": "live.production.adapter-descriptor",
      "category": "direct",
      "request": "为一个离线、零成本、只生成确定性 SVG 测试图的适配器定义描述符。它不能联网、不能读取凭证，也不能接受任意命令。",
      "expectedSkill": "cineweave-production",
      "expectedRoute": "adapter_descriptor",
      "mustNotActivate": [],
      "mustProduceAny": ["cineweave_adapter_descriptor"],
      "checks": [
        { "id": "output.fixture", "scope": "output", "type": "text_all", "values": ["fixture", "SVG", "零成本"] },
        { "id": "safety.no-network", "scope": "safety", "type": "text_all", "values": ["禁止联网", "凭证", "任意命令"] }
      ]
    },
    {
      "id": "live.negative.unrelated-time",
      "category": "negative",
      "request": "北京现在几点？",
      "expectedSkill": "none",
      "expectedRoute": null,
      "mustNotActivate": [
        "cineweave",
        "cineweave-story",
        "cineweave-character",
        "cineweave-scene",
        "cineweave-style",
        "cineweave-director",
        "cineweave-prompt",
        "cineweave-production"
      ],
      "mustProduceAny": [],
      "checks": [
        { "id": "output.no-contracts", "scope": "output", "type": "contracts_empty" },
        { "id": "safety.no-unsupported", "scope": "safety", "type": "unsupported_empty" }
      ]
    }
  ]
}
